<div class="hub-landing">
  <div class="hub-hero">
    <div class="hub-hero-inner">
      {{#if brandLogo}}
      <img class="hub-logo" src="{{brandLogo}}" alt="{{brand.name}}">
      {{/if}}
      <div class="hub-badge">{{brand.shortName}}</div>
      <h1 class="hub-title">WhatsApp<br><span>Commerce OS</span></h1>
      <p class="hub-desc">A unified WhatsApp operating system for {{brand.name}} retail ecosystem — retailer, field executive, and distributor journeys on a single number.</p>
      <div class="hub-wa-badge">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" fill="#25D366"/><path d="M17.5 14.5c-.3-.1-1.7-.8-2-.9s-.5-.2-.7.2-.8.9-1 1.1-.4.2-.7.1a8.5 8.5 0 01-2.6-1.6 9.9 9.9 0 01-1.8-2.2c-.2-.3 0-.5.1-.6l.5-.6.3-.5a.4.4 0 000-.4l-.9-2.1c-.2-.5-.5-.4-.7-.4h-.6c-.2 0-.5.1-.8.4A4.4 4.4 0 006 9.7a7.6 7.6 0 001.6 4c1.8 2.4 4.1 3.8 7.8 4.3.8.1 1.5-.1 2-.4a4 4 0 001.3-1.7c.1-.4.1-.7 0-.9z" fill="#fff"/></svg>
        {{brand.dealerStoreName}} &nbsp;·&nbsp; {{brand.name}}
      </div>
    </div>
  </div>
  <div class="hub-journeys">
    <div class="hub-section-label">Select a Module to Explore</div>
    {{#each journeyDescriptionsList}}
    <a class="hub-card" href="#s-{{@key}}" style="--c:{{this.color}}">
      <div class="hub-card-badge">
        <div class="hub-card-num">{{this.displayNum}}</div>
        <div class="hub-card-emoji">{{this.emoji}}</div>
      </div>
      <div class="hub-card-body">
        <div class="hub-card-top">
          <div class="hub-card-title">{{this.title}}</div>
          <div class="hub-card-steps">{{this.steps}} Steps</div>
        </div>
        <div class="hub-card-desc">{{this.desc}}</div>
        <div class="hub-card-tags">
          {{#each this.tags}}<span class="hub-card-tag">{{this}}</span>{{/each}}
        </div>
      </div>
    </a>
    {{/each}}
  </div>
</div>
