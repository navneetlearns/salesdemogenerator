{{!--
  WhatsApp Document screen type
  Renders a WhatsApp template message with document header
  
  Data fields:
  - documentName: string (required) - Document filename
  - documentSize: string (optional) - File size
  - documentPages: string (optional) - Page count
  - body: string (required) - Message body text
  - buttons: array (optional) - Button array [{label, url, type}]
  - time: string (optional) - Timestamp
  - senderName: string (optional) - Sender name
--}}
<div class="msg-receiver-wrap">
  <div class="wa-tmpl">
    <div class="wa-hdr-doc">
      <div class="doc-icon">
        <svg width="14" height="17" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/></svg>
      </div>
      <div class="doc-meta">
        <div class="doc-name">{{documentName}}</div>
        <div class="doc-info">{{documentSize}}{{#if documentPages}} · {{documentPages}} pages{{/if}}</div>
      </div>
    </div>
    <div class="wa-tmpl-body">{{{body}}}</div>
    {{#if buttons.length}}
    <div class="wa-tmpl-btns">
      {{#each buttons}}
        {{#if (eq type "url")}}
          <a href="{{url}}" class="wa-tmpl-btn wa-tmpl-btn-url">{{label}}</a>
        {{else}}
          {{#if url}}
            <a href="{{url}}" class="wa-tmpl-btn wa-tmpl-btn-url">{{label}}</a>
          {{else}}
            <button class="wa-tmpl-btn wa-tmpl-btn-qr">{{label}}</button>
          {{/if}}
        {{/if}}
      {{/each}}
    </div>
    {{/if}}
    <div class="wa-tmpl-time">{{time}}{{#if senderName}} · {{senderName}}{{/if}}</div>
  </div>
</div>
