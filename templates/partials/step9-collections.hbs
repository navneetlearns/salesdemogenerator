<div class="step-panel phone-layout" id="step-9">
        <div class="phone-wrap">
          <div class="screen-label">Pre-Due Reminder (Thursday) — Utility Template + Pay Now CTA</div>
          <div class="phone">
            <div class="st-bar">
              <span class="st-time">09:15</span>
              <div class="st-icons">
                {{> icons/signal-bars color="#fff"}}
                {{> icons/double-check color="#fff"}}
                {{> icons/send color="rgba(255,255,255,.8)"}}
              </div>
            </div>
            <div class="wa-bar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              <div class="wa-av" style="background:none;overflow:hidden;padding:0;"><img
                  src="{{brandLogo}}"
                  style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;"></div>
              <div class="wa-info">
                <div class="wa-name">{{brand.name}} Payment Assist</div>
                <div class="wa-sub">Business Account</div>
              </div>
              <div class="wa-acts">
                {{> icons/video color="#fff"}}
                {{> icons/phone color="#fff"}}
              </div>
            </div>
            <div class="chat">
              <div class="date-chip"><span>Thursday, 17 Apr 2025</span></div>
              <!-- Utility Template: Text header + body + CTA -->
              <div class="rw">
                <div>
                  <div class="tc">
                    <!-- Header: Text type "Payment Reminder" (16 chars ✓) -->
                    <div class="th-txt">Payment Reminder</div>
                    <!-- Body -->
                    <div class="tb">Reminder 😊<br><br>Aapne kal payment ka commitment diya tha<br><br>On-time payment
                      se:<br>🎁 Extra scheme unlock hoga<br>🎁 Fast dispatch milega<br><br>Payment link yahan hai
                      👇<br><br>Team, {{brand.name}}</div>
                    <!-- Footer: plain text ≤60 chars -->
                    <div class="tf">Managed by ZoTok powered by Zono</div>
                    <div class="tt">9:15 AM ✓✓</div>
                    <!-- CTA URL button: "Pay Now" (7 chars ✓) -->
                    <span class="tdiv"></span>
                    <button class="tbtn">
                      <svg width="13" height="13" viewBox="0 0 24 24" fill="none">
                        <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" stroke="currentColor"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        <polyline points="15 3 21 3 21 9" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                          stroke-linejoin="round" />
                        <line x1="10" y1="14" x2="21" y2="3" stroke="currentColor" stroke-width="2"
                          stroke-linecap="round" />
                      </svg>
                      Pay Now
                    </button>
                  </div>
                  <div class="zf">Managed by ZoTok powered by Zono</div>
                </div>
              </div>
            </div>
            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#fff8e1;"><strong>Pre-Due Reminder Sent</strong>ZoAi sends a warm
          reminder a day before PTP date, reinforcing the scheme benefit to maximise collection success.</div>
      </div>

