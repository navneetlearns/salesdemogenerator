{{!-- Step 3: Campaigns & Queries — 3 screens
  Screen 1 · Festive Campaign (Marketing Template)
  Screen 2 · Product Category Selection (Interactive List)
  Screen 3 · Price List Response (Utility Template — Document Header)
--}}
<div id="step-3" class="step-section">

  <!-- Screen 1: Festive Campaign -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Festive Campaign</div>
    <div class="screen-type-lbl">Marketing Template — Image Header + Quick Reply</div>
    <div class="phone-frame">
      {{> status-bar time="10:15 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step3.campaign}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#FFF9C4;">
      <strong>Festive Campaign</strong>
      ZoTok pushes a targeted campaign to all active retailers to drive seasonal orders and awareness.
    </div>
  </div>

  <!-- Screen 2: Product Category Query -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Product Category Selection</div>
    <div class="screen-type-lbl">Interactive List — Bottom Sheet Open</div>
    <div class="phone-frame">
      {{> status-bar time="10:17 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">Show me Namkeen price list</div>
            <span class="msg-time">10:17 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        <div class="msg-receiver-wrap">
          <div class="wa-list-card">
            <div class="wa-list-body">Which category would you like to explore? 🔍</div>
            <div class="wa-list-time">10:17 AM</div>
            <div class="wa-list-btn-row">
              <svg width="15" height="13" viewBox="0 0 24 20" fill="none"><line x1="0" y1="2" x2="24" y2="2" stroke="#00A884" stroke-width="2.5"/><line x1="0" y1="10" x2="24" y2="10" stroke="#00A884" stroke-width="2.5"/><line x1="0" y1="18" x2="24" y2="18" stroke="#00A884" stroke-width="2.5"/></svg>
              <span class="wa-list-btn-label">Select a category</span>
            </div>
          </div>
        </div>
      </div>
      <div class="wa-bottom-sheet" style="background:#fff;border-top:1px solid #e0e0e0;padding:12px 16px;">
        <div style="font-size:14px;font-weight:600;color:#111;margin-bottom:8px;">Product Categories</div>
        <div class="menu-row" style="display:flex;gap:8px;flex-wrap:wrap;">
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">🥜 Namkeen</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">🍬 Sweets</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">🎁 Gift Packs</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">🧆 Snacks</div>
        </div>
      </div>
    </div>
    <div class="screen-desc" style="background:#FFF9C4;">
      <strong>Product Query</strong>
      Retailer uses the interactive list to raise a query about a product category or pricing.
    </div>
  </div>

  <!-- Screen 3: Price List Response -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · Price List Response</div>
    <div class="screen-type-lbl">Utility Template — Document Header + CTA</div>
    <div class="phone-frame">
      {{> status-bar time="10:18 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step3.queryResponse}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#FFF9C4;">
      <strong>Instant Price List</strong>
      ZoAi instantly responds with the price list document for the selected category, saving hours of back-and-forth.
    </div>
  </div>
</div>
