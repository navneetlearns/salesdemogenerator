{{!-- Step 7: AI Order Capture — 3 screens
  Screen 1 · Handwritten Order Note (Session Message)
  Screen 2 · Draft Order (Interactive Template — Image Header + CTA)
  Screen 3 · Cart & Checkout (Commerce WebView)
--}}
<div id="step-7" class="step-section">

  <!-- Screen 1: Handwritten Order Note -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Retailer Sends Order Note</div>
    <div class="screen-type-lbl">Session Message — Handwritten Note + AI Acknowledgement</div>
    <div class="phone-frame">
      {{> status-bar time="11:00 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">📷 Order Note</div>
            <span class="msg-time">11:00 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        {{#with journey.messages.step7.orderNote}}
          <div class="msg-receiver-wrap">
            <div class="wa-tmpl">
              <div class="wa-tmpl-body">{{body}}</div>
              <div class="wa-tmpl-time">{{time}}</div>
            </div>
          </div>
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#FFE0B2;">
      <strong>Handwritten Order</strong>
      Retailer photographs a handwritten order note and sends it directly to the ZoTok channel on WhatsApp.
    </div>
  </div>

  <!-- Screen 2: Draft Order -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Draft Order</div>
    <div class="screen-type-lbl">Interactive Template — Image Header + CTA Buttons</div>
    <div class="phone-frame">
      {{> status-bar time="11:02 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step7.draftOrder}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#FFE0B2;">
      <strong>AI Extracts Order</strong>
      ZoAi reads the image and extracts a structured draft order with items and quantities for retailer review.
    </div>
  </div>

  <!-- Screen 3: Checkout WebView -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · Cart &amp; Checkout</div>
    <div class="screen-type-lbl">Commerce WebView — Cart Review &amp; Checkout</div>
    <div class="phone-frame">
      {{> status-bar time="11:03 AM"}}
      {{> wa-topbar back=true status=brand.name actions="more" avatarSrc=brandLogo}}
      <div class="webview-area" style="flex:1;background:#fff;padding:16px;overflow-y:auto;">
        <div style="font-size:15px;font-weight:700;color:#111;margin-bottom:12px;">🛒 Review &amp; Checkout</div>
        {{#with journey.order}}
        <div style="background:#f9f9f9;border-radius:8px;padding:12px;margin-bottom:12px;">
          <div style="font-size:12px;color:#888;margin-bottom:4px;">Order ID: <strong style="color:#111;">{{primaryOrderId}}</strong></div>
          <div style="font-size:12px;color:#888;">Date: <strong style="color:#111;">{{date}}</strong></div>
        </div>
        {{#each items}}
        <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;font-size:13px;">
          <span>{{productId}} x{{qty}}</span>
          <strong>₹{{lineTotal}}</strong>
        </div>
        {{/each}}
        {{/with}}
        {{#with journey.order.summary}}
        <div style="margin-top:12px;padding:10px;background:#f0f0f0;border-radius:8px;">
          <div style="display:flex;justify-content:space-between;font-weight:700;font-size:14px;"><span>Total</span><span>₹{{orderValue}}</span></div>
        </div>
        {{/with}}
        <div style="margin-top:12px;padding:10px;background:#075E54;color:#fff;border-radius:8px;text-align:center;font-weight:600;font-size:14px;">✅ Confirm Order</div>
      </div>
    </div>
    <div class="screen-desc" style="background:#FFE0B2;">
      <strong>Review &amp; Checkout</strong>
      Retailer reviews the AI-generated cart in a WebView and proceeds to checkout with a single tap.
    </div>
  </div>
</div>
