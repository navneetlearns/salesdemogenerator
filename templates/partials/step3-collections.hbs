<div class="step-panel phone-layout" id="step-3">
        <div class="phone-wrap">
          <div class="screen-label">AI Initiates Promise-to-Pay + Scheme Hook — Interactive Reply</div>
          <div class="phone">
            <div class="st-bar">
              <span class="st-time">10:25</span>
              <div class="st-icons">
                {{> icons/signal-bars color="#fff"}}
                {{> icons/double-check color="#fff"}}
                {{> icons/send color="rgba(255,255,255,.8)"}}
              </div>
            </div>
            <div class="wa-bar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              <div class="wa-av u-avatar-circle-bg"><img
                  src="{{brandLogo}}"
                  class="u-avatar-circle"></div>
              <div class="wa-info">
                <div class="wa-name">{{brand.name}} Payment Assist</div>
                <div class="wa-sub">online</div>
              </div>
              <div class="wa-acts">
                {{> icons/video color="#fff"}}
                {{> icons/phone color="#fff"}}
              </div>
            </div>
            <div class="chat">
              <div class="date-chip"><span>Monday, 14 Apr 2025</span></div>
              <!-- Interactive Reply Buttons — session message -->
              <div class="rw">
                <div class="im">
                  <div class="im-body">Agar aap <strong>Tuesday, 15 Apr</strong> tak payment karte hain:<br><br>🎁 2%
                    extra scheme next order pe<br>🎁 Fast delivery priority milegi<br><br>Kya aap Tuesday tak payment
                    kar paayenge?</div>
                  <div class="im-time">10:25 AM</div>
                  <!-- Reply buttons: "Kar dunga" (9 chars ✓) | "Nahi ho paayega" (15 chars ✓) — both ≤20 -->
                  <button class="im-btn">Kar dunga</button>
                  <button class="im-btn">Nahi ho paayega</button>
                </div>
              </div>
            </div>
            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#ede7f6;"><strong>AI Initiates PTP + Scheme Hook</strong>ZoAi
          presents a time-sensitive scheme incentive to nudge the retailer to commit to a payment date.</div>
      </div>

      <!-- ═══════════════════════════ STEP 4 ═══════════════════════════ -->
      