{{!-- Step 8: Cash Discount & Payment Reminder — Utility Template (2 sub-screens)
--}}
<div id="step-8" class="step-section">
      <div class="step2-phones">

        <!-- Screen 1: Cash Discount Reminder -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 1 · Cash Discount Expiring</div>
          <div class="screen-type-lbl">Utility Template — Document Header + Quick Reply (Auto-reminder)</div>
          <div class="phone-frame">
            {{> status-bar time="10:00 AM"}}
            {{> wa-topbar status="ZoTok Business" actions="call" compact=true avatarSrc=brandLogo}}
            <div class="chat-area">
              {{> date-pill text="Today"}}
              <div class="msg-receiver-wrap">
                <div class="wa-tmpl">
                  <div class="wa-hdr-doc">
                    <div class="doc-icon">{{> icons/document color="#54656f"}}</div>
                    <div class="doc-meta"><div class="doc-name">Invoice_{{journey.order.primaryOrderId}}.pdf</div><div class="doc-info">2 pages · 1.4 MB · pdf</div></div>
                    <div class="doc-dl">{{> icons/download color="#555"}}</div>
                  </div>
                  <div class="wa-tmpl-body">
                    <strong style="font-size:13px;display:block;margin-bottom:6px;">{{journey.content.cashDiscountReminder}}</strong>
                    Dear {{journey.dealer.name}}, this is a friendly reminder that your 2.5% cash discount on Invoice <strong>JK-{{journey.invoice.id}}</strong> expires tomorrow — <strong>{{journey.invoice.date}}</strong>.<br><br>
                    Generate your payment advice today to avail the discount. 🙏<br><br>
                    🧾 Invoice No: <strong>JK-{{journey.invoice.id}}</strong><br>
                    🏷 Discount: <strong>2.5% = {{formatCurrency journey.invoice.discount}}</strong><br>
                    ✅ Pay Today &amp; Save: <strong>{{formatCurrency journey.payment.amount}}</strong><br>
                    ⏳ Discount Valid Until: <strong>{{journey.invoice.date}}</strong>
                  </div>
                  <div class="wa-tmpl-signoff">Team,<br>{{brand.name}}</div>
                  <div class="wa-tmpl-time">10:00 AM</div>
                                    <div class="wa-tmpl-btns">
                    <div class="wa-qr-btn">{{> icons/check-circle color="#00A884"}}{{journey.content.generatePaymentAdvice}}</div>
                    <div class="wa-qr-btn">{{> icons/check-circle color="#00A884"}}Raise an Issue</div>
                  </div>
                          </div>
              </div>
            </div>
            <div class="input-bar">{{> icons/plus-circle color="#54656f"}}<div class="input-field">Type a message</div>{{> icons/microphone color="#54656f"}}</div>
          </div>
          <div class="screen-desc" style="background:#FFE0B2;">
            <strong>Cash Discount Reminder (Auto)</strong>
            ZoTok automatically sends this reminder 1 day before the 7-day cash discount deadline. Dealers who haven't paid yet see exactly how much they stand to save — creating urgency without being pushy.
          </div>
        </div><!-- /phone-wrap Screen 2 -->

        <!-- Screen 3: Due Date Reminder (3 days before due date) -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 2 · Payment Due Soon</div>
          <div class="screen-type-lbl">Utility Template — Document Header + Quick Reply (Auto-reminder)</div>
          <div class="phone-frame">
            {{> status-bar time="9:00 AM"}}
            {{> wa-topbar status="ZoTok Business" actions="call" compact=true avatarSrc=brandLogo}}
            <div class="chat-area">
              {{> date-pill text="Today"}}
              <div class="msg-receiver-wrap">
                <div class="wa-tmpl">
                  <div class="wa-hdr-doc">
                    <div class="doc-icon">{{> icons/document color="#54656f"}}</div>
                    <div class="doc-meta"><div class="doc-name">Invoice_{{journey.order.primaryOrderId}}.pdf</div><div class="doc-info">2 pages · 1.4 MB · pdf</div></div>
                    <div class="doc-dl">{{> icons/download color="#555"}}</div>
                  </div>
                  <div class="wa-tmpl-body">
                    <strong style="font-size:13px;display:block;margin-bottom:6px;">{{journey.content.invoicePaymentDue}}</strong>
                    Dear {{journey.dealer.name}}, your invoice <strong>JK-{{journey.invoice.id}}</strong> for <strong>{{formatCurrency journey.order.summary.orderValue}}</strong> is due on <strong>{{journey.invoice.dueDate}}</strong> — just 3 days away.<br><br>
                    Kindly generate your payment advice at the earliest to ensure uninterrupted supply of future orders. 🙏<br><br>
                    🧾 Invoice No: <strong>JK-{{journey.invoice.id}}</strong><br>
                    💰 Amount Due: <strong>{{formatCurrency journey.order.summary.orderValue}}</strong><br>
                    ⏰ Due Date: <strong>{{journey.invoice.dueDate}}</strong><br>
                    📆 Days Remaining: <strong>3 days</strong>
                  </div>
                  <div class="wa-tmpl-signoff">Team,<br>{{brand.name}}</div>
                  <div class="wa-tmpl-time">9:00 AM</div>
                                    <div class="wa-tmpl-btns">
                    <div class="wa-qr-btn">{{> icons/check-circle color="#00A884"}}{{journey.content.generatePaymentAdvice}}</div>
                    <div class="wa-qr-btn">{{> icons/check-circle color="#00A884"}}Raise an Issue</div>
                  </div>
                          </div>
              </div>
            </div>
            <div class="input-bar">{{> icons/plus-circle color="#54656f"}}<div class="input-field">Type a message</div>{{> icons/microphone color="#54656f"}}</div>
          </div>
          <div class="screen-desc" style="background:#FFCCCC;">
            <strong>Due Date Reminder (Auto)</strong>
            ZoTok sends this automated nudge 3 days before the invoice due date to dealers with outstanding payments. The message references future order supply — a strong motivator for timely settlement.
          </div>
        </div><!-- /phone-wrap Screen 3 -->

      
      </div><!-- /phones-row -->
    </div><!-- /step-8 -->
