<div class="step-panel phone-layout" id="step-2">
        <div class="phone-wrap">
          <div class="screen-label">Invoice Breakdown — Session Message</div>
          <div class="phone">
            <div class="st-bar">
              <span class="st-time">10:24</span>
              <div class="st-icons">
                {{> icons/signal-bars color="#fff"}}
                {{> icons/double-check color="#fff"}}
                {{> icons/send color="rgba(255,255,255,.8)"}}
              </div>
            </div>
            <div class="wa-bar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              <div class="wa-av" style="background:none;overflow:hidden;padding:0;"><img
                  src="{{brandLogo}}"
                  style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;"></div>
              <div class="wa-info">
                <div class="wa-name">{{brand.name}} Payment Assist</div>
                <div class="wa-sub">online</div>
              </div>
              <div class="wa-acts">
                {{> icons/video color="#fff"}}
                {{> icons/phone color="#fff"}}
              </div>
            </div>
            <div class="chat">
              <div class="date-chip"><span>Monday, 14 Apr 2025</span></div>
              <!-- Prior template — condensed & faded -->
              <div class="rw">
                <div class="tc faded" style="max-width:88%;">
                  <div class="tb" style="font-size:11.5px;padding:5px 12px 3px;">Namaste Ravi ji 🙏 — outstanding
                    <strong>₹48,500</strong> · Last supply: 7 days
                  </div>
                  <div class="tt" style="padding:0 12px 4px;font-size:10px;">10:22 AM ✓✓</div>
                  <span class="tdiv"></span>
                  <div style="display:flex;">
                    <button class="tbtn" style="font-size:12px;padding:7px 12px;border-right:1px solid #f0f0f0;">Invoice
                      dekhein</button>
                    <button class="tbtn" style="font-size:12px;padding:7px 12px;">Scheme check karein</button>
                  </div>
                </div>
              </div>
              <!-- AI sends invoice breakdown -->
              <div class="rw">
                <div class="rb">
                  <div class="mb">Invoice-wise breakup:<br><br><strong>Invoice #HD-45821</strong> — ₹18,200<br>Items:
                    Aloo Bhujia, Mixture<br><br><strong>Invoice #HD-46210</strong> — ₹30,300<br>Items: Combo
                    Packs<br><br><strong>Total Outstanding: ₹48,500</strong></div>
                  <div class="mt">10:24 AM</div>
                </div>
              </div>
            </div>
            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#e8f5e9;"><strong>AI-Driven Invoice Breakdown</strong>Retailer asks
          about pending bills — ZoAi instantly shares invoice-wise details within the WhatsApp thread.</div>
      </div>

      <!-- ═══════════════════════════ STEP 3 ═══════════════════════════ -->
      