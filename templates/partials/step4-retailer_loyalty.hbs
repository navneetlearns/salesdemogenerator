{{!-- Turnover-Based Loyalty Scheme — Step 4: Exclusive Offers --}}
<div class="step-section" id="step-4">
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Exclusive Offers</div>
    <div class="screen-type-lbl">Interactive Template — Offers List</div>
    <div class="phone-frame">
      {{> status-bar time="10:15 AM"}}
      {{> wa-topbar status="ZoTok Business" actions="call" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-receiver-wrap">
          <div class="wa-tmpl">
            <div class="wa-hdr-img" style="background:linear-gradient(135deg,var(--brand),var(--brand-dark));padding:20px;text-align:center;border-radius:12px 12px 0 0;">
              <div style="font-size:32px;margin-bottom:4px;">🎁</div>
              <div style="color:#fff;font-size:18px;font-weight:700;">{{journey.messages.step4.heading}}</div>
              <div style="color:rgba(255,255,255,0.85);font-size:13px;">{{brand.name}} Loyalty Members</div>
            </div>
            <div class="wa-tmpl-body">
              {{{journey.messages.step4.body}}}<br><br>
              {{#each journey.loyalty.offers}}
              <div style="background:#f9f9f9;border-radius:10px;padding:12px;margin-bottom:10px;border:1px solid #eee;">
                <div style="font-size:16px;font-weight:700;color:var(--brand);">🔥 {{title}}</div>
                <div style="font-size:13px;color:#555;margin:4px 0;">{{desc}}</div>
                <div style="display:flex;justify-content:space-between;font-size:11px;color:#888;">
                  <span>⏱ Valid until: {{validUntil}}</span>
                  <span style="background:var(--brand);color:#fff;padding:2px 8px;border-radius:4px;font-weight:600;">{{code}}</span>
                </div>
              </div>
              {{/each}}
              <br>
              <span style="font-size:12px;color:#888;">Use the promo code when placing your order to avail the offer!</span>
            </div>
            <div class="wa-tmpl-signoff">Team,<br>{{brand.name}} India</div>
            <div class="wa-tmpl-time">10:15 AM</div>
            <div class="wa-tmpl-btns">
              <div class="wa-cta-btn">{{> icons/attach color="#00A884"}}Place Order with Code</div>
              <div class="wa-cta-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M12 1v22M1 12h22" stroke="#00A884" stroke-width="2.5" stroke-linecap="round"/></svg>View All Offers</div>
            </div>
          </div>
        </div>
      </div>
      <div class="input-bar">{{> icons/plus-circle color="#54656f"}}<div class="input-field">Type a message</div>{{> icons/microphone color="#54656f"}}</div>
    </div>
    <div class="screen-desc" style="background:#F0D8A8;">
      <strong>Exclusive Loyalty Offers</strong>
      Retailer sees personalized offers available only to loyalty program members — bulk discounts, member specials, and referral bonuses with promo codes and validity dates.
    </div>
  </div>
</div><!-- /step-4 -->
