<div id="step-6" class="step-section">

        <!-- Illustration — left -->
        <div class="step6-img">
          <img
            src="{{fieldOpsImage "fo_82287605aba9.png"}}"
            alt="Sales Executive taking order">
          <div class="img-caption"><strong>Order Capture &amp; Review</strong>SE photographs the retailer's handwritten
            order — ZoAi reads it, structures the line items, and posts a draft order in the group for quick review.
          </div>
        </div>

        <!-- Screen 1: Order image capture -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 1 · Order Capture</div>
          <div class="group-phone">
            <div class="w-statusbar">
              <span class="w-stime">10:25</span>
              <div class="w-sicons">
                {{> icons/signal-bars color="#111"}}
                {{> icons/double-check color="#111"}}
                <div class="w-bat">68</div>
              </div>
            </div>
            <div class="g-topbar">
              <div class="g-back">{{> icons/back color="#007AFF"}}</div>
              <div class="g-ava u-avatar-circle-bg"><img src="{{brandLogo}}"
                  class="u-avatar-circle"></div>
              <div class="g-info">
                <div class="g-name">{{brand.name}} x Manish Nagar</div>
                <div class="g-sub">Ravi Singh, Deepak Sharma, ZoAi</div>
              </div>
              <div class="g-acts">
                {{> icons/video color="#333"}}
                {{> icons/three-dots color="#333"}}
              </div>
            </div>
            <div class="g-chat">
              <div class="dpill">Today</div>
              <!-- Continuity: check-in confirmation from Step 5 -->
              <div class="msw">
                <div class="mr">
                  <div class="sname u-text-teal">ZoAi 🤖</div>
                  <div class="mbody">Checked In ✅<br><br>📍 <strong>Store:</strong> Sharma Supermart, Manish Nagar<br>⏰
                    <strong>Time:</strong> 10:15 AM<br>📅 <strong>Date:</strong> 08 Apr 2026<br>👤 <strong>SE:</strong>
                    Ravi Singh
                  </div>
                  <span class="mtime">10:16 AM</span>
                </div>
              </div>
              <!-- Ravi sends handwritten order image -->
              <div class="mrw">
                <div class="you-lbl u-text-green">You (Ravi Singh)</div>
                <div class="ms" style="padding:3px 3px 4px;max-width:218px;">
                  <!-- Paper note image -->
                  <img
                    src="{{fieldOpsImage "fo_02b8234f14bc.png"}}"
                    style="width:210px;height:152px;object-fit:cover;border-radius:4px;box-shadow:1px 3px 8px rgba(0,0,0,.22);display:block;" />
                  <!-- Caption -->
                  <div class="mbody" style="padding:5px 8px 0 6px;">@zoai order</div>
                  <span class="mtime" style="padding-right:4px;">10:25 AM <span class="mtick">✓✓</span></span>
                </div>
              </div>
            </div>
            <div class="g-ibar">
              {{> icons/plus-circle color="#54656f"}}
              <div class="g-ifield">Type a message</div>
              {{> icons/microphone color="#54656f"}}
            </div>
          </div>
          <div class="screen-desc u-bg-blue">
            <strong>Order Capture</strong>
            Ravi photos the handwritten order note and sends @zoai order — AI reads and structures it
          </div>
        </div>

        <!-- Screen 2: ZoAi structured order response -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 2 · Order Created</div>
          <div class="group-phone">
            <div class="w-statusbar">
              <span class="w-stime">10:26</span>
              <div class="w-sicons">
                {{> icons/signal-bars color="#111"}}
                {{> icons/double-check color="#111"}}
                <div class="w-bat">68</div>
              </div>
            </div>
            <div class="g-topbar">
              <div class="g-back">{{> icons/back color="#007AFF"}}</div>
              <div class="g-ava u-avatar-circle-bg"><img src="{{brandLogo}}"
                  class="u-avatar-circle"></div>
              <div class="g-info">
                <div class="g-name">{{brand.name}} x Manish Nagar</div>
                <div class="g-sub">Ravi Singh, Deepak Sharma, ZoAi</div>
              </div>
              <div class="g-acts">
                {{> icons/video color="#333"}}
                {{> icons/three-dots color="#333"}}
              </div>
            </div>
            <div class="g-chat" id="s6-chat-2">
              <div class="dpill">Today</div>
              <!-- Order image echoed -->
              <div class="mrw">
                <div class="you-lbl u-text-green">You (Ravi Singh)</div>
                <div class="ms" style="padding:3px 3px 4px;max-width:218px;">
                  <img
                    src="{{fieldOpsImage "fo_02b8234f14bc.png"}}"
                    style="width:210px;height:152px;object-fit:cover;border-radius:4px;box-shadow:1px 3px 8px rgba(0,0,0,.22);display:block;" />
                  <div class="mbody" style="padding:5px 8px 0 6px;">@zoai order</div>
                  <span class="mtime" style="padding-right:4px;">10:25 AM <span class="mtick">✓✓</span></span>
                </div>
              </div>
              <!-- ZoAi Draft Order (group session message — extracted from image, one CTA short URL) -->
              <div class="msw">
                <div class="mr" style="max-width:240px;padding:0 0 4px;">
                  <div class="sname u-text-teal">ZoAi 🤖</div>
                  <!-- Image header: the notepad photo used to create the order -->
                  <img
                    src="{{fieldOpsImage "fo_02b8234f14bc.png"}}"
                    style="width:100%;height:84px;object-fit:cover;border-bottom:2px solid #e0d8c0;display:block;" />
                  <!-- Body -->
                  <div class="mbody" style="padding:8px 10px 4px;">
                    📋 <strong>Draft Order</strong><br><br>
                    🪪 <strong>Order ID:</strong> HDR-1042<br>
                    📦 <strong>Total SKUs:</strong> 3<br>
                    💰 <strong>Total Order Value:</strong> ₹7,850<br>
                    💵 <strong>Net Order Value:</strong> ₹7,850<br><br>
                    Team,<br>{{brand.name}}
                  </div>
                  <!-- Single CTA short URL -->
                  <div style="padding:5px 10px 4px;border-top:1px solid #f0f0f0;font-size:11.5px;color:#00A884;">
                    ↗ Review and edit order - zotok.ai/ord/svr1042
                  </div>
                  <span class="mtime" style="padding-right:6px;">10:26 AM</span>
                </div>
              </div>
            </div>
            <div class="g-ibar">
              {{> icons/plus-circle color="#54656f"}}
              <div class="g-ifield">Type a message</div>
              {{> icons/microphone color="#54656f"}}
            </div>
          </div>
          <div class="screen-desc u-bg-green">
            <strong>Draft Order Created</strong>
            ZoAi reads the order note image, extracts items and value, and posts a draft order with a "Review and edit"
            link for Ravi to confirm
          </div>
        </div>

      </div><!-- /step-6 -->