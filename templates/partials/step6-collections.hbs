<div class="step-panel phone-layout" id="step-6">
        <div class="phone-wrap">
          <div class="screen-label">Retailer Selects Alternate Date — Taps "Friday"</div>
          <div class="phone">
            <div class="st-bar">
              <span class="st-time">10:27</span>
              <div class="st-icons">
                {{> icons/signal-bars color="#fff"}}
                {{> icons/double-check color="#fff"}}
                {{> icons/send color="rgba(255,255,255,.8)"}}
              </div>
            </div>
            <div class="wa-bar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              <div class="wa-av" style="background:none;overflow:hidden;padding:0;"><img
                  src="{{brandLogo}}"
                  style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;"></div>
              <div class="wa-info">
                <div class="wa-name">{{brand.name}} Payment Assist</div>
                <div class="wa-sub">online</div>
              </div>
              <div class="wa-acts">
                {{> icons/video color="#fff"}}
                {{> icons/phone color="#fff"}}
              </div>
            </div>
            <div class="chat">
              <div class="date-chip"><span>Monday, 14 Apr 2025</span></div>
              <!-- Date selection message — faded -->
              <div class="rw">
                <div class="im faded">
                  <div class="im-body" style="font-size:11.5px;">Samajh gaya 👍 Aap kaunsa din comfortable
                    rahenge?<br>Main check karta hoon us date pe kaunsa scheme unlock hoga</div>
                  <div class="im-time" style="font-size:10px;">10:26 AM</div>
                  <div style="display:flex;border-top:1px solid #f0f0f0;">
                    <button class="im-btn"
                      style="font-size:12px;padding:8px;border-top:none;border-right:1px solid #f0f0f0;border-bottom:none;border-left:none;">Thursday</button>
                    <button class="im-btn"
                      style="font-size:12px;padding:8px;border-top:none;border-right:1px solid #f0f0f0;border-bottom:none;border-left:none;">Friday</button>
                    <button class="im-btn"
                      style="font-size:12px;padding:8px;border-top:none;border-bottom:none;border-left:none;border-right:none;">Next
                      Week</button>
                  </div>
                </div>
              </div>
              <!-- User taps "Friday" -->
              <div class="sw">
                <div class="sb">
                  <div class="mb">Friday</div>
                  <div class="mt">10:27 AM <span class="tick">✓✓</span></div>
                </div>
              </div>
            </div>
            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#f9fbe7;"><strong>Retailer Commits to Friday</strong>Retailer selects
          Friday — ZoAi captures the promise-to-pay and queues the confirmation flow.</div>
      </div>

      <!-- ═══════════════════════════ STEP 7 ═══════════════════════════ -->
      