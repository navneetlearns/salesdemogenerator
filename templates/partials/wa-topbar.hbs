{{!-- WhatsApp top bar with contact name, status, and action icons --}}
            <div class="wa-topbar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              {{#if compact}}
              <div class="tb-av"><img src="{{avatarSrc}}" alt="{{brand.name}}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"></div>
              {{else}}
              <div class="wa-avatar" style="background:none;overflow:hidden;padding:0;"><img src="{{avatarSrc}}"
                  style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;" /></div>
              {{/if}}
              <div class="wa-contact">
                <div class="wa-contact-name">{{brand.name}}</div>
                <div class="wa-contact-status">{{status}}</div>
              </div>
              {{#if actions}}
              <div class="wa-actions">
                {{#eq actions "call"}}
                {{> icons/phone color="#fff"}}
                {{else}}
                {{> icons/video color="#fff"}}
                {{> icons/three-dots-h color="#fff"}}
                {{/eq}}
              </div>
              {{/if}}
            </div>