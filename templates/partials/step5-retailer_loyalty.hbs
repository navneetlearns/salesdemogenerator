{{!-- Turnover-Based Loyalty Scheme — Step 5: Redemption History --}}
<div class="step-section" id="step-5">
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Redemption History</div>
    <div class="screen-type-lbl">Interactive Template — History Table</div>
    <div class="phone-frame">
      {{> status-bar time="10:20 AM"}}
      {{> wa-topbar status="ZoTok Business" actions="call" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-receiver-wrap">
          <div class="wa-tmpl">
            <div class="wa-hdr-img" style="background:linear-gradient(135deg,var(--brand),var(--brand-dark));padding:20px;text-align:center;border-radius:12px 12px 0 0;">
              <div style="font-size:32px;margin-bottom:4px;">📋</div>
              <div style="color:#fff;font-size:18px;font-weight:700;">{{journey.messages.step5.heading}}</div>
              <div style="color:rgba(255,255,255,0.85);font-size:13px;">Last 4 redemptions</div>
            </div>
            <div class="wa-tmpl-body">
              {{{journey.messages.step5.body}}}<br><br>
              <table style="width:100%;border-collapse:collapse;font-size:12px;">
                <thead>
                  <tr style="background:#f5f5f5;">
                    <th style="padding:8px 6px;text-align:left;border-bottom:2px solid var(--brand);">Date</th>
                    <th style="padding:8px 6px;text-align:left;border-bottom:2px solid var(--brand);">Item</th>
                    <th style="padding:8px 6px;text-align:right;border-bottom:2px solid var(--brand);">Points</th>
                    <th style="padding:8px 6px;text-align:center;border-bottom:2px solid var(--brand);">Status</th>
                  </tr>
                </thead>
                <tbody>
                {{#each journey.loyalty.redemptions}}
                  <tr>
                    <td style="padding:8px 6px;border-bottom:1px solid #eee;color:#555;">{{date}}</td>
                    <td style="padding:8px 6px;border-bottom:1px solid #eee;font-weight:600;">{{item}}</td>
                    <td style="padding:8px 6px;border-bottom:1px solid #eee;text-align:right;color:var(--brand);">{{points}}</td>
                    <td style="padding:8px 6px;border-bottom:1px solid #eee;text-align:center;"><span style="background:#e8f5e9;color:#2e7d32;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:600;">{{status}}</span></td>
                  </tr>
                {{/each}}
                </tbody>
              </table>
              <br>
              <b>Available Balance:</b> {{journey.loyalty.points.balance}} pts
            </div>
            <div class="wa-tmpl-signoff">Team,<br>{{brand.name}} India</div>
            <div class="wa-tmpl-time">10:20 AM</div>
            <div class="wa-tmpl-btns">
              <div class="wa-cta-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" stroke="#00A884" stroke-width="2.5"/><polyline points="15 3 21 3 21 9" stroke="#00A884" stroke-width="2.5"/><line x1="10" y1="14" x2="21" y2="3" stroke="#00A884" stroke-width="2.5"/></svg>Redeem Now</div>
              <div class="wa-cta-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M12 1v22M1 12h22" stroke="#00A884" stroke-width="2.5" stroke-linecap="round"/></svg>Download Statement</div>
            </div>
          </div>
        </div>
      </div>
      <div class="input-bar"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg><div class="input-field">Type a message</div><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    </div>
    <div class="screen-desc" style="background:#A8EAD6;">
      <strong>Redemption History</strong>
      Retailer views a detailed table of past reward redemptions with dates, items, points spent, and status — all within WhatsApp.
    </div>
  </div>
</div><!-- /step-5 -->
