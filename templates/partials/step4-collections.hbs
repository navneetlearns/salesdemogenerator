<div class="step-panel phone-layout" id="step-4">
        <div class="phone-wrap">
          <div class="screen-label">Retailer Declines — Taps "Nahi ho paayega"</div>
          <div class="phone">
            <div class="st-bar">
              <span class="st-time">10:26</span>
              <div class="st-icons">
                {{> icons/signal-bars color="#fff"}}
                {{> icons/double-check color="#fff"}}
                {{> icons/send color="rgba(255,255,255,.8)"}}
              </div>
            </div>
            <div class="wa-bar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              <div class="wa-av u-avatar-circle-bg"><img
                  src="{{brandLogo}}"
                  class="u-avatar-circle"></div>
              <div class="wa-info">
                <div class="wa-name">{{brand.name}} Payment Assist</div>
                <div class="wa-sub">online</div>
              </div>
              <div class="wa-acts">
                {{> icons/video color="#fff"}}
                {{> icons/phone color="#fff"}}
              </div>
            </div>
            <div class="chat">
              <div class="date-chip"><span>Monday, 14 Apr 2025</span></div>
              <!-- PTP message — faded -->
              <div class="rw">
                <div class="im faded">
                  <div class="im-body" style="font-size:11.5px;">Agar aap <strong>Tuesday, 15 Apr</strong> tak payment
                    karte hain:<br>🎁 2% extra scheme · 🎁 Fast delivery priority</div>
                  <div class="im-time" style="font-size:10px;">10:25 AM</div>
                  <button class="im-btn" style="font-size:12px;padding:8px 12px;">Kar dunga</button>
                  <button class="im-btn" style="font-size:12px;padding:8px 12px;">Nahi ho paayega</button>
                </div>
              </div>
              <!-- User taps "Nahi ho paayega" -->
              <div class="sw">
                <div class="sb">
                  <div class="mb">Nahi ho paayega</div>
                  <div class="mt">10:26 AM <span class="tick">✓✓</span></div>
                </div>
              </div>
            </div>
            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#fff3e0;"><strong>Retailer Declines — AI Handles
            Gracefully</strong>Retailer taps "Nahi ho paayega" — ZoAi acknowledges and pivots to negotiation without
          losing the conversation.</div>
      </div>

