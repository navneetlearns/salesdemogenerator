<div class="step-panel phone-layout" id="step-5">
        <div class="phone-wrap">
          <div class="screen-label">AI Asks Alternate Date — Warm Tone + 3 Options</div>
          <div class="phone">
            <div class="st-bar">
              <span class="st-time">10:26</span>
              <div class="st-icons">
                {{> icons/signal-bars color="#fff"}}
                {{> icons/double-check color="#fff"}}
                {{> icons/send color="rgba(255,255,255,.8)"}}
              </div>
            </div>
            <div class="wa-bar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              <div class="wa-av u-avatar-circle-bg"><img
                  src="{{brandLogo}}"
                  class="u-avatar-circle"></div>
              <div class="wa-info">
                <div class="wa-name">{{brand.name}} Payment Assist</div>
                <div class="wa-sub">online</div>
              </div>
              <div class="wa-acts">
                {{> icons/video color="#fff"}}
                {{> icons/phone color="#fff"}}
              </div>
            </div>
            <div class="chat">
              <div class="date-chip"><span>Monday, 14 Apr 2025</span></div>
              <!-- User's prior reply — faded -->
              <div class="sw">
                <div class="sb" style="opacity:.55;">
                  <div class="mb" style="font-size:12px;">Nahi ho paayega</div>
                  <div class="mt" style="font-size:10px;">10:26 AM <span class="tick">✓✓</span></div>
                </div>
              </div>
              <!-- AI asks for alternate date -->
              <div class="rw">
                <div class="im">
                  <div class="im-body">Samajh gaya 👍<br><br>Aap kaunsa din comfortable rahenge?<br><br>Main check karta
                    hoon us date pe kaunsa scheme unlock hoga</div>
                  <div class="im-time">10:26 AM</div>
                  <!-- Reply buttons: "Thursday" (8) | "Friday" (6) | "Next Week" (9) — all ≤20 ✓ -->
                  <button class="im-btn">Thursday</button>
                  <button class="im-btn">Friday</button>
                  <button class="im-btn">Next Week</button>
                </div>
              </div>
            </div>
            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#e0f7fa;"><strong>AI Offers Alternate Payment Dates</strong>ZoAi
          proposes flexible dates with scheme unlocks — retailer picks what works for their cashflow.</div>
      </div>

      <!-- ═══════════════════════════ STEP 6 ═══════════════════════════ -->
      