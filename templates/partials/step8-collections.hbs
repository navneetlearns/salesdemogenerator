<div class="step-panel phone-layout" id="step-8">
        <div class="phone-wrap">
          <div class="screen-label">Retailer Confirms PTP — Promise Registered</div>
          <div class="phone">
            <div class="st-bar">
              <span class="st-time">10:28</span>
              <div class="st-icons">
                {{> icons/signal-bars color="#fff"}}
                {{> icons/double-check color="#fff"}}
                {{> icons/send color="rgba(255,255,255,.8)"}}
              </div>
            </div>
            <div class="wa-bar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              <div class="wa-av" style="background:none;overflow:hidden;padding:0;"><img
                  src="{{brandLogo}}"
                  style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;"></div>
              <div class="wa-info">
                <div class="wa-name">{{brand.name}} Payment Assist</div>
                <div class="wa-sub">online</div>
              </div>
              <div class="wa-acts">
                {{> icons/video color="#fff"}}
                {{> icons/phone color="#fff"}}
              </div>
            </div>
            <div class="chat">
              <div class="date-chip"><span>Monday, 14 Apr 2025</span></div>
              <!-- Prior scheme message — faded -->
              <div class="rw">
                <div class="im faded">
                  <div class="im-body" style="font-size:11.5px;">Friday, 18 Apr tak: 🎁 1% extra scheme · 🎁 SKU
                    priority · 🎁 Festival eligibility</div>
                  <div class="im-time" style="font-size:10px;">10:27 AM</div>
                  <button class="im-btn" style="font-size:12px;padding:8px;">Confirm karein</button>
                </div>
              </div>
              <!-- User confirms -->
              <div class="sw">
                <div class="sb">
                  <div class="mb">Confirm karein</div>
                  <div class="mt">10:28 AM <span class="tick">✓✓</span></div>
                </div>
              </div>
              <!-- AI confirmation -->
              <div class="rw">
                <div class="rb">
                  <div class="mb">Perfect 👍<br><br>Aapka Promise-to-Pay register ho gaya hai:<br><br>Amount:
                    <strong>₹48,500</strong><br>Date: <strong>Friday, 18 Apr 2025</strong><br><br>Is payment par aapko
                    1% scheme benefit milega<br>Main ek din pehle reminder bhej dunga 🔔
                  </div>
                  <div class="mt">10:28 AM</div>
                </div>
              </div>
            </div>
            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#e8eaf6;"><strong>PTP Confirmed & Logged</strong>Promise-to-pay is
          registered in ZoTok — sales team and distributor are notified automatically.</div>
      </div>

      <!-- ═══════════════════════════ STEP 9 ═══════════════════════════ -->
      