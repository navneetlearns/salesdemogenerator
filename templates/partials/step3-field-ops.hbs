<div id="step-3" class="step-section">

        <!-- Sales executive illustration — left -->
        <div class="step3-img">
          <img
            src="{{fieldOpsImage "fo_e6641740a4d4.png"}}">
          <div class="img-caption"><strong>Start Day &amp; Clock-In</strong>Sales Executive sends the @zoai clock-in
            command in the WhatsApp group with live location — attendance logged automatically.</div>
        </div>

        <!-- Screen 1: Clock-in command -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 1 · Clock-In Command</div>
          <div class="group-phone">
            <div class="w-statusbar">
              <span class="w-stime">9:14</span>
              <div class="w-sicons">
                {{> icons/signal-bars color="#111"}}
                {{> icons/double-check color="#111"}}
                <div class="w-bat">86</div>
              </div>
            </div>
            <div class="g-topbar">
              <div class="g-back">
                {{> icons/back color="#007AFF"}}
              </div>
              <div class="g-ava" style="background:none;overflow:hidden;padding:0;"><img src="{{brandLogo}}"
                  style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;"></div>
              <div class="g-info">
                <div class="g-name">{{brand.name}} x Manish Nagar</div>
                <div class="g-sub">Ravi Singh, Deepak Sharma, ZoAi</div>
              </div>
              <div class="g-acts">
                {{> icons/video color="#333"}}
                {{> icons/three-dots color="#333"}}
              </div>
            </div>
            <div class="g-chat">
              <div class="dpill">Today</div>
              <!-- Ravi Singh shares live location -->
              <div class="mrw">
                <div class="you-lbl" style="color:#2E7D32;">You (Ravi Singh)</div>
                <div class="ms" style="padding:5px 5px 4px;max-width:215px;">
                  <div style="border-radius:6px;overflow:hidden;margin-bottom:4px;">
                    <!-- Map thumbnail -->
                    <div style="height:90px;position:relative;overflow:hidden;">
                      <svg width="215" height="90" viewBox="0 0 215 90" xmlns="http://www.w3.org/2000/svg"
                        style="display:block;">
                        <rect width="215" height="90" fill="#d4e8d0" />
                        <!-- Roads -->
                        <line x1="0" y1="45" x2="215" y2="45" stroke="#b8d4b4" stroke-width="7" />
                        <line x1="108" y1="0" x2="108" y2="90" stroke="#b8d4b4" stroke-width="7" />
                        <line x1="0" y1="22" x2="215" y2="22" stroke="#c5dcc2" stroke-width="2" opacity=".7" />
                        <line x1="0" y1="68" x2="215" y2="68" stroke="#c5dcc2" stroke-width="2" opacity=".7" />
                        <line x1="54" y1="0" x2="54" y2="90" stroke="#c5dcc2" stroke-width="2" opacity=".7" />
                        <line x1="162" y1="0" x2="162" y2="90" stroke="#c5dcc2" stroke-width="2" opacity=".7" />
                        <!-- City blocks -->
                        <rect x="6" y="4" width="44" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="60" y="4" width="44" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="116" y="4" width="42" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="166" y="4" width="42" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="6" y="52" width="44" height="28" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="60" y="52" width="44" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="116" y="52" width="42" height="28" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="166" y="52" width="42" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <!-- Map pin -->
                        <path d="M108 10c-6.6 0-12 5.4-12 12 0 9 12 22 12 22s12-13 12-22c0-6.6-5.4-12-12-12z"
                          fill="#10A7E1" />
                        <circle cx="108" cy="22" r="4.5" fill="#fff" />
                      </svg>
                    </div>
                    <!-- Location label -->
                    <div style="padding:6px 9px 3px;background:#DCF8C6;">
                      <div style="font-size:12.5px;font-weight:600;color:#111B21;">📍 {{brand.name}} Office, Nagpur</div>
                      <div style="font-size:10.5px;color:#667781;margin-top:1px;">Manish Nagar, Nagpur · Live Location
                      </div>
                    </div>
                  </div>
                  <span class="mtime" style="padding-right:2px;">9:14 AM <span class="mtick">✓✓</span></span>
                </div>
              </div>
              <!-- Sales exec replies to location with @zoai clock-in -->
              <div class="mrw">
                <div class="you-lbl" style="color:#2E7D32;">You (Ravi Singh)</div>
                <div class="ms">
                  <div class="rq" style="border-color:#2E7D32;">
                    <div class="rq-snd" style="color:#2E7D32;">You (Ravi Singh)</div>
                    <div class="rq-txt">📍 {{brand.name}} Office, Nagpur</div>
                  </div>
                  <div class="mbody">@zoai clock-in</div>
                  <span class="mtime">9:14 AM <span class="mtick">✓✓</span></span>
                </div>
              </div>
            </div>
            <div class="g-ibar">
              {{> icons/plus-circle color="#54656f"}}
              <div class="g-ifield">Type a message</div>
              {{> icons/microphone color="#54656f"}}
            </div>
          </div>
          <div class="screen-desc" style="background:#F4EEB4;">
            <strong>Clock-In Command</strong>
            Ravi shares live location from {{brand.name}} Office and replies @zoai clock-in to mark attendance
          </div>
        </div>

        <!-- Screen 2: Clock-in success -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 2 · Clock-In Confirmed</div>
          <div class="group-phone">
            <div class="w-statusbar">
              <span class="w-stime">9:15</span>
              <div class="w-sicons">
                {{> icons/signal-bars color="#111"}}
                {{> icons/double-check color="#111"}}
                <div class="w-bat">85</div>
              </div>
            </div>
            <div class="g-topbar">
              <div class="g-back">
                {{> icons/back color="#007AFF"}}
              </div>
              <div class="g-ava" style="background:none;overflow:hidden;padding:0;"><img src="{{brandLogo}}"
                  style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;"></div>
              <div class="g-info">
                <div class="g-name">{{brand.name}} x Manish Nagar</div>
                <div class="g-sub">Ravi Singh, Deepak Sharma, ZoAi</div>
              </div>
              <div class="g-acts">
                {{> icons/video color="#333"}}
                {{> icons/three-dots color="#333"}}
              </div>
            </div>
            <div class="g-chat">
              <div class="dpill">Today</div>
              <!-- Sender bubble (from screen 1) -->
              <div class="mrw">
                <div class="you-lbl" style="color:#2E7D32;">You (Ravi Singh)</div>
                <div class="ms">
                  <div class="rq" style="border-color:#2E7D32;">
                    <div class="rq-snd" style="color:#2E7D32;">You (Ravi Singh)</div>
                    <div class="rq-txt">📍 {{brand.name}} Office, Nagpur</div>
                  </div>
                  <div class="mbody">@zoai clock-in</div>
                  <span class="mtime">9:14 AM <span class="mtick">✓✓</span></span>
                </div>
              </div>
              <!-- ZoAi clock-in success -->
              <div class="msw">
                <div class="mr">
                  <div class="sname" style="color:#00897B;">ZoAi 🤖</div>
                  <div class="mbody">Clocked In ✅<br><br>⏰ <strong>Time:</strong> 9:14 AM<br>📍
                    <strong>Location:</strong> {{brand.name}} Office, Nagpur<br>📅 <strong>Date:</strong> 08 Apr 2026<br>👤
                    <strong>Name:</strong> Ravi Singh (SE)
                  </div>
                  <span class="mtime">9:15 AM</span>
                </div>
              </div>
            </div>
            <div class="g-ibar">
              {{> icons/plus-circle color="#54656f"}}
              <div class="g-ifield">Type a message</div>
              {{> icons/microphone color="#54656f"}}
            </div>
          </div>
          <div class="screen-desc" style="background:#A8EAD6;">
            <strong>Clock-In Confirmed</strong>
            ZoAi confirms instantly — time, location and date logged automatically in the group
          </div>
        </div>

      </div><!-- /step-3 -->