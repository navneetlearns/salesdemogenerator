{{!-- Step 10: Invoice & Payment — 3 screens
  Screen 1 · Invoice Shared (Utility Template — Document Header + CTA)
  Screen 2 · Payment Reminder (Utility Template — Image Header UPI QR + CTA)
  Screen 3 · Payment Received (Utility Template — No Header)
--}}
<div id="step-10" class="step-section">

  <!-- Screen 1: Invoice Shared -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Invoice Shared</div>
    <div class="screen-type-lbl">Utility Template — Document Header + CTA Buttons</div>
    <div class="phone-frame">
      {{> status-bar time="11:30 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step10.invoice}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#E0F2F1;">
      <strong>Invoice on WhatsApp</strong>
      Retailer receives the invoice PDF directly on WhatsApp with a payment link and UPI QR code.
    </div>
  </div>

  <!-- Screen 2: Payment Reminder with UPI QR -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Payment Reminder</div>
    <div class="screen-type-lbl">Utility Template — Image Header (UPI QR) + CTA Buttons</div>
    <div class="phone-frame">
      {{> status-bar time="11:35 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step10.paymentReminder}}
          {{> whatsapp-message}}
        {{/with}}
        <div class="msg-receiver-wrap">
          <div class="msg-receiver">
            <div style="text-align:center;padding:8px;">
              <div style="width:100px;height:100px;background:#fff;border:1px solid #ddd;margin:0 auto 8px;display:flex;align-items:center;justify-content:center;font-size:10px;color:#888;">[UPI QR]</div>
              <div style="font-size:11px;color:#075E54;font-weight:600;">Scan to Pay</div>
            </div>
            <span class="msg-time">{{journey.messages.step10.paymentReminder.time}}</span>
          </div>
        </div>
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#E0F2F1;">
      <strong>UPI Payment</strong>
      Retailer scans the QR code or taps 'Pay Now' to complete payment via UPI — without leaving WhatsApp.
    </div>
  </div>

  <!-- Screen 3: Payment Confirmed -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · Payment Received</div>
    <div class="screen-type-lbl">Utility Template — No Header</div>
    <div class="phone-frame">
      {{> status-bar time="11:40 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step10.paymentConfirmed}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#E0F2F1;">
      <strong>Payment Confirmed</strong>
      ZoTok sends an instant payment receipt to the retailer, closing the order-to-cash cycle.
    </div>
  </div>
</div>
