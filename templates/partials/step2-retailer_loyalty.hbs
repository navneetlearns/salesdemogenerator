{{!-- Turnover-Based Loyalty Scheme — Step 2: Points & Rewards --}}
<div class="step-section" id="step-2">
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Points Balance</div>
    <div class="screen-type-lbl">Session Interactive Message — Points Summary Card</div>
    <div class="phone-frame">
      {{> status-bar time="10:05 AM"}}
      {{> wa-topbar status="ZoTok Business" actions="call" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-receiver-wrap">
          <div class="wa-tmpl">
            <div class="wa-hdr-img" style="background:linear-gradient(135deg,var(--brand),var(--brand-dark));padding:20px;text-align:center;border-radius:12px 12px 0 0;">
              <div style="font-size:28px;margin-bottom:4px;">⭐</div>
              <div style="color:#fff;font-size:24px;font-weight:800;">{{journey.loyalty.points.balance}}</div>
              <div style="color:rgba(255,255,255,0.85);font-size:13px;">{{journey.loyalty.points.currency}}</div>
            </div>
            <div class="wa-tmpl-body">
              <b>📊 {{journey.messages.step2.heading}}</b><br><br>
              {{{journey.messages.step2.body}}}<br><br>
              <b>Lifetime Points Earned:</b> {{journey.loyalty.points.lifetime}} pts<br>
              <b>Conversion Rate:</b> {{journey.loyalty.points.rate}}<br><br>
              <b>💰 Earning Rates:</b><br>
              {{#each journey.loyalty.earningRates}}
              • <b>{{activity}}</b> — {{rate}}{{#if bonus}}<br><span style="font-size:12px;color:var(--brand);">🔥 {{bonus}}</span>{{/if}}<br>
              {{/each}}
            </div>
            <div class="wa-tmpl-signoff">Team,<br>{{brand.name}} India</div>
            <div class="wa-tmpl-time">10:05 AM</div>
            <div class="wa-tmpl-btns">
              <div class="wa-cta-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" stroke="#00A884" stroke-width="2.5"/><polyline points="15 3 21 3 21 9" stroke="#00A884" stroke-width="2.5"/><line x1="10" y1="14" x2="21" y2="3" stroke="#00A884" stroke-width="2.5"/></svg>Redeem Points</div>
              <div class="wa-cta-btn"><svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M12 1v22M1 12h22" stroke="#00A884" stroke-width="2.5" stroke-linecap="round"/></svg>View Catalog</div>
            </div>
          </div>
        </div>
      </div>
      <div class="input-bar"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg><div class="input-field">Type a message</div><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    </div>
    <div class="screen-desc" style="background:#A8EAD6;">
      <strong>Points Balance &amp; Earning Rates</strong>
      Retailer views current points balance, lifetime earnings, and detailed earning rates for purchases, early payments, bulk orders, and referrals.
    </div>
  </div>

  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Rewards Catalog</div>
    <div class="screen-type-lbl">Interactive List — Rewards Available</div>
    <div class="phone-frame">
      {{> status-bar time="10:06 AM"}}
      {{> wa-topbar status="ZoTok Business" actions="call" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">Show me reward options</div>
            <span class="msg-time">10:06 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        <div class="msg-receiver-wrap">
          <div class="wa-list-card">
            <div class="wa-list-body">🎁 Here are the rewards you can redeem with your <b>{{journey.loyalty.points.balance}}</b> points:<br><br>
              🧰 <b>Hardware Voucher ₹5,000</b> — 45,000 pts<br>
              🎫 <b>E-Gift Card ₹2,500</b> — 22,500 pts<br>
              📦 <b>Free Cement 5 Bags</b> — 35,000 pts<br>
              👕 <b>Merchandise Kit</b> — 12,000 pts<br>
              🚚 <b>Free Delivery Pass</b> — 8,000 pts<br><br>
              <span style="font-size:12px;color:#888;">Reply with the item name to redeem!</span>
            </div>
            <div class="wa-list-time">10:06 AM</div>
            <div class="wa-list-btn-row">
              <svg width="15" height="13" viewBox="0 0 24 20" fill="none"><line x1="0" y1="2" x2="24" y2="2" stroke="#00A884" stroke-width="2.5"/><line x1="0" y1="10" x2="24" y2="10" stroke="#00A884" stroke-width="2.5"/><line x1="0" y1="18" x2="24" y2="18" stroke="#00A884" stroke-width="2.5"/></svg>
              <span class="wa-list-btn-label">Available Rewards</span>
            </div>
          </div>
        </div>
      </div>
      <div class="input-bar"><svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg><div class="input-field">Type a message</div><svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
    </div>
    <div class="screen-desc" style="background:#F0D8A8;">
      <strong>Rewards Catalog</strong>
      Retailer browses available reward items with point costs — hardware vouchers, gift cards, free products, and merchandise — all redeemable directly in WhatsApp.
    </div>
  </div>
</div><!-- /step-2 -->
