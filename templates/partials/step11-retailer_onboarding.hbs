{{!-- Step 11: Collect Digital Orders — 3 screens
  Screen 1 · Distributor Menu (Interactive List)
  Screen 2 · Select Retailers (Commerce WebView — Retailer Nudge List)
  Screen 3 · Order Nudge to Retailer (Utility Template — Image Header + CTA)
--}}
<div id="step-11" class="step-section">

  <!-- Screen 1: Distributor Menu -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Distributor Menu</div>
    <div class="screen-type-lbl">Interactive List — Channel Partner Menu</div>
    <div class="phone-frame">
      {{> status-bar time="2:00 PM"}}
      {{> wa-topbar status="Partner Portal" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-receiver-wrap">
          <div class="wa-list-card">
            <div class="wa-list-body"><strong>{{journey.distributor.name}}</strong><br>{{brand.name}} Partner Portal</div>
            <div class="wa-list-time">2:00 PM</div>
            <div class="wa-list-btn-row">
              {{> icons/list-menu color="#00A884"}}
              <span class="wa-list-btn-label">Drive more orders</span>
            </div>
          </div>
        </div>
      </div>
      <div class="wa-bottom-sheet" style="background:#fff;border-top:1px solid #e0e0e0;padding:12px 16px;">
        <div style="font-size:14px;font-weight:600;color:#111;margin-bottom:8px;">Partner Dashboard</div>
        <div class="menu-row" style="display:flex;gap:8px;flex-wrap:wrap;">
          <div class="menu-chip u-chip">📣 Nudge Retailers</div>
          <div class="menu-chip u-chip">📊 Order Reports</div>
          <div class="menu-chip u-chip">👥 Retailer List</div>
        </div>
      </div>
    </div>
    <div class="screen-desc" style="background:#F8BBD0;">
      <strong>Distributor Menu</strong>
      Distributor accesses their self-service menu to manage order nudges and collections.
    </div>
  </div>

  <!-- Screen 2: Select Retailers -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Select Retailers</div>
    <div class="screen-type-lbl">Commerce WebView — Retailer Nudge List</div>
    <div class="phone-frame">
      {{> status-bar time="2:02 PM"}}
      {{> wa-topbar back=true status="Retailer Selection" actions="more" avatarSrc=brandLogo}}
      <div class="webview-area" style="flex:1;background:#fff;padding:16px;overflow-y:auto;">
        <div style="font-size:15px;font-weight:700;color:#111;margin-bottom:12px;">Select Retailers to Nudge</div>
        <div style="border:1px solid #e8e8e8;border-radius:10px;padding:12px;margin-bottom:8px;">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="checkbox" checked> <span style="font-size:13px;font-weight:600;">{{journey.retailer.storeName}}</span>
          </label>
          <div style="font-size:11px;color:#888;margin-top:4px;">Last order: {{journey.order.date}} · ₹{{journey.order.summary.orderValue}}</div>
        </div>
        <div style="border:1px solid #e8e8e8;border-radius:10px;padding:12px;margin-bottom:8px;">
          <label style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="checkbox"> <span style="font-size:13px;font-weight:600;">Patel Sweet Mart</span>
          </label>
          <div style="font-size:11px;color:#888;margin-top:4px;">Last order: {{nudgeRetailers.1.lastOrderDate}} · {{formatCurrency nudgeRetailers.1.lastOrderValue}}</div>
        </div>
        <div style="margin-top:12px;padding:10px;background:#075E54;color:#fff;border-radius:8px;text-align:center;font-weight:600;font-size:14px;">📣 Send Nudge to 1 Retailer</div>
      </div>
    </div>
    <div class="screen-desc" style="background:#F8BBD0;">
      <strong>Retailer Selection</strong>
      Distributor picks retailers to nudge for orders and reviews order status before sending the campaign.
    </div>
  </div>

  <!-- Screen 3: Order Nudge Sent -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · Order Nudge to Retailer</div>
    <div class="screen-type-lbl">Utility Template — Image Header + CTA + Quick Reply</div>
    <div class="phone-frame">
      {{> status-bar time="2:05 PM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step11.nudgeSent}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#F8BBD0;">
      <strong>Order Campaign Sent</strong>
      Selected retailers receive a WhatsApp nudge prompting them to place their next order directly through the channel.
    </div>
  </div>
</div>
