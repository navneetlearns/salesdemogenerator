{{!-- Step 5: Order Confirmed Notification — Utility Template + PWA (2 sub-screens)
--}}
<div id="step-5" class="step-section">
      <div class="step2-phones">

        <!-- Screen 1: WhatsApp DM — Order Confirmed Template -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 1 · Order Confirmed</div>
          <div class="screen-type-lbl">Utility Template — Document Header + CTA URL</div>
          <div class="phone-frame">
            {{> status-bar time="11:05 AM"}}
            {{> wa-topbar status="ZoTok Business" actions="call" compact=true avatarSrc="data:image/placeholder"}}
            <div class="chat-area">
              {{> date-pill text="Today"}}
              <!-- Previous order submitted message (greyed read receipt) -->
              <div class="msg-receiver-wrap" style="opacity:.55;">
                <div class="wa-tmpl" style="max-width:220px;">
                  <div class="wa-hdr-doc">
                    <div class="doc-icon"><svg width="14" height="17" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/></svg></div>
                    <div class="doc-meta"><div class="doc-name">Order_{{journey.order.primaryOrderId}}.pdf</div><div class="doc-info">1 page · 0.6 MB · pdf</div></div>
                    <div class="doc-dl"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></div>
                  </div>
                  <div class="wa-tmpl-body" style="font-size:11px;color:#888;">Order Received · 10:28 AM</div>
                </div>
              </div>
              <!-- Order Confirmed message -->
              <div class="msg-receiver-wrap">
                <div class="wa-tmpl">
                  <div class="wa-hdr-doc">
                    <div class="doc-icon"><svg width="14" height="17" viewBox="0 0 24 24" fill="white"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8" fill="none" stroke="white" stroke-width="2"/></svg></div>
                    <div class="doc-meta">
                      <div class="doc-name">Order_{{journey.order.primaryOrderId}}.pdf</div>
                      <div class="doc-info">1 page · 0.6 MB · pdf</div>
                    </div>
                    <div class="doc-dl"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></div>
                  </div>
                  <div class="wa-tmpl-body">
                    <strong style="font-size:13px;display:block;margin-bottom:6px;">Order Confirmed ✔</strong>
                    Your order has been confirmed and is being processed.<br><br>
                    🪪 Order ID: <strong>{{journey.order.primaryOrderId}}</strong><br>
                    🏪 Dealer: <strong>{{journey.dealer.name}}, Hyderabad</strong><br>
                    📦 Total SKUs: <strong>4</strong><br>
                    💰 Order Value: <strong>{{formatCurrency journey.order.summary.orderValue}}</strong><br>
                    📅 Date: <strong>{{journey.order.date}}</strong>
                  </div>
                  <div class="wa-tmpl-body" style="padding-top:2px;padding-bottom:2px;">
                    Team,<br>{{brand.name}}
                  </div>
                  <div class="wa-tmpl-time">11:05 AM</div>
                  <div class="wa-tmpl-btns">
                    <div class="wa-cta-btn">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6" stroke="#00A884" stroke-width="2.5"/><polyline points="15 3 21 3 21 9" stroke="#00A884" stroke-width="2.5"/><line x1="10" y1="14" x2="21" y2="3" stroke="#00A884" stroke-width="2.5"/></svg>
                      View Order Details
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="input-bar">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
              <div class="input-field">Type a message</div>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div><!-- /phone-frame -->
          <div class="screen-desc" style="background:#C8F5D8;">
            <strong>Order Confirmed Notification</strong>
            {{brand.name}}'s ERP triggers a WhatsApp confirmation once the order is approved. The previous "Order Received" message is shown faded for context. The single CTA links to read-only order details.
          </div>
        </div><!-- /phone-wrap Screen 1 -->

        <!-- Screen 2: PWA — Read-only Order Details -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 2 · Order Details — Read Only (PWA)</div>
          <div class="screen-type-lbl">Commerce WebView — PWA Confirmed Order (Locked)</div>
          <div class="phone-frame-web">
            {{> status-bar-web time="11:06" battery="82"}}
            <div class="browser-bar">
              <span class="browser-done">Done</span>
              <div class="browser-url-wrap">
                <div class="browser-title">Order Details</div>
                <div class="browser-url"><svg width="9" height="9" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="6" r="5.5" stroke="#888" stroke-width="1"/><path d="M6 1v10M1 6h10" stroke="#888" stroke-width=".7"/><path d="M2 3.5Q6 2 10 3.5M2 8.5Q6 10 10 8.5" stroke="#888" stroke-width=".7" fill="none"/></svg> mobile.zotok.ai</div>
              </div>
              <span class="browser-menu">···</span>
            </div>
            <div class="pwa-content">
              <!-- Brand strip: Approved status -->
              <div class="brand-strip">
                <div class="bs-logo">
                  <img src="data:image/placeholder" alt="{{brand.name}}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"/>
                </div>
                <div class="bs-info">
                  <div class="bs-title">Order {{journey.order.primaryOrderId}}</div>
                  <div class="bs-sub">{{journey.dealer.name}} · {{journey.order.date}}</div>
                </div>
                <div class="bs-status" style="background:rgba(72,220,120,.25);">✔ Approved</div>
              </div>
              <!-- Locked info banner -->
              <div style="background:#F0FFF4;padding:7px 12px;display:flex;align-items:center;gap:7px;border-bottom:1px solid #C3E6CB;flex-shrink:0;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="5" y="11" width="14" height="10" rx="2" stroke="#2E7D32" stroke-width="2"/><path d="M8 11V7a4 4 0 018 0v4" stroke="#2E7D32" stroke-width="2" stroke-linecap="round"/></svg>
                <span style="font-size:11px;color:#2E7D32;font-weight:600;">Order confirmed — items and quantities are locked</span>
              </div>
              <!-- Section header -->
              <div class="section-hdr">
                <div class="section-hdr-title">Order Items</div>
                <div class="section-hdr-sub">4 Items</div>
              </div>
              <!-- Product list (read-only) -->
              <div style="flex:1;overflow-y:auto;">
                <div class="order-item-row">
                  <div class="oi-thumb" style="overflow:hidden;padding:0;"><img src="data:image/placeholder" style="width:100%;height:100%;object-fit:cover;" /></div>
                  <div class="oi-info">
                    <div class="oi-name">{{journey.productNames.cementPpc}}</div>
                    <div class="oi-sub">IS 12269 Certified · 53 Grade</div>
                    <div class="oi-price">{{formatCurrency journey.order.items.0.lineTotal}}</div>
                  </div>
                  <div class="oi-qty-block">
                    <span class="oi-qty-lbl">Qty</span>
                    <div class="oi-qty-val">100</div>
                  </div>
                </div>
                <div class="order-item-row">
                  <div class="oi-thumb" style="overflow:hidden;padding:0;"><img src="data:image/placeholder" style="width:100%;height:100%;object-fit:cover;" /></div>
                  <div class="oi-info">
                    <div class="oi-name">{{journey.productNames.opc43}}</div>
                    <div class="oi-sub">{{journey.productNames.ppcTag1}}</div>
                    <div class="oi-price">{{formatCurrency journey.order.items.1.lineTotal}}</div>
                  </div>
                  <div class="oi-qty-block">
                    <span class="oi-qty-lbl">Qty</span>
                    <div class="oi-qty-val">8</div>
                  </div>
                </div>
                <div class="order-item-row">
                  <div class="oi-thumb" style="overflow:hidden;padding:0;"><img src="data:image/placeholder" style="width:100%;height:100%;object-fit:cover;" /></div>
                  <div class="oi-info">
                    <div class="oi-name">{{journey.productNames.opc53}}</div>
                    <div class="oi-sub">{{journey.productNames.ppcTag2}}</div>
                    <div class="oi-price">{{formatCurrency journey.order.items.2.lineTotal}}</div>
                  </div>
                  <div class="oi-qty-block">
                    <span class="oi-qty-lbl">Qty</span>
                    <div class="oi-qty-val">5</div>
                  </div>
                </div>
                <div class="order-item-row" style="border-bottom:none;">
                  <div class="oi-thumb" style="overflow:hidden;padding:0;"><img src="data:image/placeholder" style="width:100%;height:100%;object-fit:cover;" /></div>
                  <div class="oi-info">
                    <div class="oi-name">{{journey.productNames.ppc}}</div>
                    <div class="oi-sub">IS 269 Certified · OPC</div>
                    <div class="oi-price">{{formatCurrency journey.order.items.0.lineTotal}}</div>
                  </div>
                  <div class="oi-qty-block">
                    <span class="oi-qty-lbl">Qty</span>
                    <div class="oi-qty-val">4</div>
                  </div>
                </div>
              </div>
              <!-- Order summary -->
              {{#with cart.summary}}
                {{> order-summary}}
              {{/with}}
              <!-- Download CTA (read-only — no edit) -->
              <div class="sticky-cta">
                <button class="cta-btn-dl">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4" stroke="#444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><polyline points="7 10 12 15 17 10" stroke="#444" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="12" y1="15" x2="12" y2="3" stroke="#444" stroke-width="2" stroke-linecap="round"/></svg>
                  Download Order PDF
                </button>
              </div>
            </div><!-- /pwa-content -->
            <div class="browser-nav">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="18" cy="5" r="3" stroke="#555" stroke-width="1.8"/><circle cx="6" cy="12" r="3" stroke="#555" stroke-width="1.8"/><circle cx="18" cy="19" r="3" stroke="#555" stroke-width="1.8"/><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" stroke="#555" stroke-width="1.8"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><polyline points="23 4 23 10 17 10" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div><!-- /phone-frame-web -->
          <div class="screen-desc" style="background:#D4EDDA;">
            <strong>Confirmed Order Details — Read Only</strong>
            Once confirmed, the dealer sees a locked view: the green "Approved" status badge, a lock banner, and all items are display-only. The "Update order" button is replaced with "Download Order PDF" — no edits are possible.
          </div>
        </div><!-- /phone-wrap Screen 2 -->

      </div><!-- /phones-row -->
    </div><!-- /step-5 -->
    