{{!-- Step 12: Collect Payments — 3 screens
  Screen 1 · Distributor Menu (Interactive List)
  Screen 2 · Pending Invoices (Commerce WebView — Invoice Payment Tracker)
  Screen 3 · Payment Reminder (Buyer Perspective — Invoice Nudge sent to Retailer)
--}}
<div id="step-12" class="step-section">

  <!-- Screen 1: Distributor Menu -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Distributor Menu</div>
    <div class="screen-type-lbl">Interactive List — Channel Partner Menu</div>
    <div class="phone-frame">
      {{> status-bar time="3:00 PM"}}
      {{> wa-topbar status="Partner Portal" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-receiver-wrap">
          <div class="wa-list-card">
            <div class="wa-list-body"><strong>{{journey.distributor.name}}</strong><br>{{brand.name}} Partner Portal</div>
            <div class="wa-list-time">3:00 PM</div>
            <div class="wa-list-btn-row">
              {{> icons/list-menu color="#00A884"}}
              <span class="wa-list-btn-label">Track payments</span>
            </div>
          </div>
        </div>
      </div>
      <div class="wa-bottom-sheet" style="background:#fff;border-top:1px solid #e0e0e0;padding:12px 16px;">
        <div style="font-size:14px;font-weight:600;color:#111;margin-bottom:8px;">Partner Dashboard</div>
        <div class="menu-row" style="display:flex;gap:8px;flex-wrap:wrap;">
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">🧾 Pending Invoices</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">⏰ Send Reminders</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">✅ Paid Invoices</div>
        </div>
      </div>
    </div>
    <div class="screen-desc" style="background:#FFCDD2;">
      <strong>Distributor Menu</strong>
      Distributor accesses their self-service menu to manage order fulfilment, invoicing, and collections.
    </div>
  </div>

  <!-- Screen 2: Pending Invoices Dashboard -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Pending Invoices</div>
    <div class="screen-type-lbl">Commerce WebView — Invoice Payment Tracker</div>
    <div class="phone-frame">
      {{> status-bar time="3:02 PM"}}
      {{> wa-topbar back=true status="Payment Tracker" actions="more" avatarSrc=brandLogo}}
      <div class="webview-area" style="flex:1;background:#fff;padding:16px;overflow-y:auto;">
        <div style="font-size:15px;font-weight:700;color:#111;margin-bottom:12px;">🧾 Pending Invoices</div>
        {{#with journey}}
        <div style="border:1px solid #ffcdd2;border-radius:10px;padding:12px;margin-bottom:8px;background:#fff5f5;">
          <div style="display:flex;justify-content:space-between;">
            <div><span style="font-size:13px;font-weight:600;">{{invoice.id}}</span></div>
            <div><span style="font-size:12px;color:#d32f2f;font-weight:600;">Overdue</span></div>
          </div>
          <div style="font-size:11px;color:#888;">{{retailer.storeName}} · Due {{invoice.dueDate}}</div>
          <div style="font-size:13px;font-weight:700;color:#111;margin-top:4px;">₹{{invoice.amount}}</div>
        </div>
        {{/with}}
        <div style="margin-top:12px;padding:10px;background:#ff9800;color:#fff;border-radius:8px;text-align:center;font-weight:600;font-size:13px;">⏰ Send Reminder to {{journey.retailer.storeName}}</div>
      </div>
    </div>
    <div class="screen-desc" style="background:#FFCDD2;">
      <strong>Invoice Dashboard</strong>
      Distributor views all retailers with pending invoices and triggers a payment nudge with one tap.
    </div>
  </div>

  <!-- Screen 3: Payment Reminder Sent -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · Payment Reminder</div>
    <div class="screen-type-lbl">Buyer Perspective — Invoice Nudge sent to Retailer</div>
    <div class="phone-frame">
      {{> status-bar time="3:05 PM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step12.paymentNudge}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#FFCDD2;">
      <strong>Payment Nudge Sent</strong>
      Retailer receives the invoice PDF on WhatsApp with a payment reminder and a direct UPI payment link.
    </div>
  </div>
</div>
