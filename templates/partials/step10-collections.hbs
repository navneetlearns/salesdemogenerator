              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#e8f5e9;"><strong>Payment Received — Collection
            Closed</strong>Payment confirmed — ZoAi immediately notifies the retailer, activates the scheme benefit, and
          closes the collection cycle.</div>
