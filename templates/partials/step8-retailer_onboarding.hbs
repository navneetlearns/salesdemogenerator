{{!-- Step 8: Distributor Confirmation — 3 screens
  Screen 1 · DT Receives Order (Utility Template — Text Header + CTA)
  Screen 2 · DT Order Review (Commerce WebView)
  Screen 3 · DT Accepts Order (Utility Template — Document Header + CTA)
--}}
<div id="step-8" class="step-section">

  <!-- Screen 1: DT Receives Order -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · DT Receives Order</div>
    <div class="screen-type-lbl">Utility Template — Text Header + CTA Buttons</div>
    <div class="phone-frame">
      {{> status-bar time="11:05 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step8.orderReceived}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#BBDEFB;">
      <strong>Order Alert to Distributor</strong>
      The distributor's ZoTok channel receives the retailer's order as a WhatsApp message for review and confirmation.
    </div>
  </div>

  <!-- Screen 2: DT Order Review Portal -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · DT Order Review</div>
    <div class="screen-type-lbl">Commerce WebView — Order Review &amp; Edit</div>
    <div class="phone-frame">
      {{> status-bar time="11:06 AM"}}
      {{> wa-topbar back=true status="Distributor Portal" actions="more" avatarSrc=brandLogo}}
      <div class="webview-area" style="flex:1;background:#fff;padding:16px;overflow-y:auto;">
        <div style="font-size:15px;font-weight:700;color:#111;margin-bottom:12px;">📋 Order Review Portal</div>
        <div style="background:#f9f9f9;border-radius:8px;padding:12px;margin-bottom:12px;">
          <div style="font-size:12px;color:#888;margin-bottom:4px;">Order: <strong style="color:#111;">{{journey.order.primaryOrderId}}</strong></div>
          <div style="font-size:12px;color:#888;margin-bottom:4px;">Retailer: <strong style="color:#111;">{{journey.retailer.storeName}}</strong></div>
          <div style="font-size:12px;color:#888;margin-bottom:4px;">Date: <strong style="color:#111;">{{journey.order.date}}</strong></div>
        </div>
        {{#each journey.order.items}}
        <div style="display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #f0f0f0;font-size:13px;">
          <span>{{productId}} × {{qty}}</span>
          <strong>₹{{lineTotal}}</strong>
        </div>
        {{/each}}
        <div style="margin-top:12px;display:flex;gap:8px;">
          <div style="flex:1;padding:10px;background:#4CAF50;color:#fff;border-radius:8px;text-align:center;font-weight:600;font-size:13px;">✅ Accept</div>
          <div style="flex:1;padding:10px;background:#f44336;color:#fff;border-radius:8px;text-align:center;font-weight:600;font-size:13px;">✏️ Edit</div>
        </div>
      </div>
    </div>
    <div class="screen-desc" style="background:#BBDEFB;">
      <strong>Order Review Portal</strong>
      Distributor reviews the full order details in the ZoTok portal — items, quantities, pricing, and retailer info.
    </div>
  </div>

  <!-- Screen 3: DT Accepts Order -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · DT Accepts Order</div>
    <div class="screen-type-lbl">Utility Template — Document Header + CTA Buttons</div>
    <div class="phone-frame">
      {{> status-bar time="11:10 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step8.orderAccepted}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#BBDEFB;">
      <strong>Order Accepted</strong>
      Distributor confirms the order. The retailer is automatically notified with an order acceptance message.
    </div>
  </div>
</div>
