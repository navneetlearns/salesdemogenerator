{{!-- WhatsApp phone status bar with time, signal, wifi, battery icons --}}
            <div class="status-bar">
              <span class="status-time">{{time}}</span>
              <div class="status-icons">
                <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                  <rect x="0" y="7" width="3" height="4" rx=".5" fill="#fff" />
                  <rect x="4" y="4.5" width="3" height="6.5" rx=".5" fill="#fff" />
                  <rect x="8" y="2" width="3" height="9" rx=".5" fill="#fff" />
                  <rect x="12" y="0" width="3" height="11" rx=".5" fill="#fff" />
                </svg>
                <svg width="15" height="11" viewBox="0 0 24 18" fill="none">
                  <path d="M12 14a2 2 0 110 4 2 2 0 010-4z" fill="#fff" />
                  <path d="M5.6 9.4a9 9 0 0112.8 0" stroke="#fff" stroke-width="2.2" stroke-linecap="round"
                    fill="none" />
                  <path d="M2 5.8A14 14 0 0122 5.8" stroke="#fff" stroke-width="2.2" stroke-linecap="round"
                    fill="none" />
                </svg>
                <svg width="22" height="12" viewBox="0 0 22 12" fill="none">
                  <rect x="0" y="1" width="18" height="10" rx="2" stroke="#fff" stroke-width="1.5" />
                  <rect x="1.5" y="2.5" width="14.5" height="7" rx="1" fill="#fff" />
                  <path d="M19 4v4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              </div>
            </div>