<div class="step-panel phone-layout" id="step-7">
        <div class="phone-wrap">
          <div class="screen-label">Scheme Unlocked for Friday — Interactive Reply + Confirm CTA</div>
          <div class="phone">
            <div class="st-bar">
              <span class="st-time">10:27</span>
              <div class="st-icons">
                {{> icons/signal-bars color="#fff"}}
                {{> icons/double-check color="#fff"}}
                {{> icons/send color="rgba(255,255,255,.8)"}}
              </div>
            </div>
            <div class="wa-bar">
              <div class="wa-back">{{> icons/back color="#fff"}}</div>
              <div class="wa-av" style="background:none;overflow:hidden;padding:0;"><img
                  src="{{brandLogo}}"
                  style="width:100%;height:100%;object-fit:cover;border-radius:50%;display:block;"></div>
              <div class="wa-info">
                <div class="wa-name">{{brand.name}} Payment Assist</div>
                <div class="wa-sub">online</div>
              </div>
              <div class="wa-acts">
                {{> icons/video color="#fff"}}
                {{> icons/phone color="#fff"}}
              </div>
            </div>
            <div class="chat">
              <div class="date-chip"><span>Monday, 14 Apr 2025</span></div>
              <!-- User's "Friday" — faded -->
              <div class="sw">
                <div class="sb" style="opacity:.55;">
                  <div class="mb" style="font-size:12px;">Friday</div>
                  <div class="mt" style="font-size:10px;">10:27 AM <span class="tick">✓✓</span></div>
                </div>
              </div>
              <!-- AI discloses scheme for Friday -->
              <div class="rw">
                <div class="im">
                  <div class="im-body">Agar aap <strong>Friday, 18 Apr</strong> tak payment karte hain:<br><br>🎁 1%
                    extra scheme next order pe<br>🎁 High-moving SKUs priority allocation<br>🎁 Festival scheme
                    eligibility unlock<br><br>Confirm karna chahenge?</div>
                  <div class="im-time">10:27 AM</div>
                  <!-- Single reply button: "Confirm karein" (14 chars ✓) -->
                  <button class="im-btn" style="font-weight:700;color:#00A884;">Confirm karein</button>
                </div>
              </div>
            </div>
            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#f3e5f5;"><strong>Scheme Unlocked for PTP Date</strong>ZoAi
          automatically unlocks the applicable scheme benefit tied to the committed payment date.</div>
      </div>

