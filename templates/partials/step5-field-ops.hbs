<div id="step-5" class="step-section">

        <!-- Illustration — left -->
        <div class="step5-img">
          <img
            src="{{fieldOpsImage "fo_206eebdfe32e.png"}}"
            alt="Sales Executive meets retailer">
          <div class="img-caption"><strong>Travel &amp; Check-In</strong>SE arrives at the store and sends @zoai
            check-in — visit is geo-stamped and the retailer's order history surfaces instantly.</div>
        </div>

        <!-- Screen 1: Check-in action -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 1 · Check-In Command</div>
          <div class="group-phone">
            <div class="w-statusbar">
              <span class="w-stime">10:15</span>
              <div class="w-sicons">
                {{> icons/signal-bars color="#111"}}
                {{> icons/double-check color="#111"}}
                <div class="w-bat">74</div>
              </div>
            </div>
            <div class="g-topbar">
              <div class="g-back">
                {{> icons/back color="#007AFF"}}
              </div>
              <div class="g-ava u-avatar-circle-bg"><img
                  src="{{brandLogo}}"
                  class="u-avatar-circle"></div>
              <div class="g-info">
                <div class="g-name">{{brand.name}} x Manish Nagar</div>
                <div class="g-sub">Ravi Singh, Deepak Sharma, ZoAi</div>
              </div>
              <div class="g-acts">
                {{> icons/video color="#333"}}
                {{> icons/three-dots color="#333"}}
              </div>
            </div>
            <div class="g-chat">
              <div class="dpill">Today</div>
              <!-- Ravi shares store location -->
              <div class="mrw">
                <div class="you-lbl u-text-green">You (Ravi Singh)</div>
                <div class="ms" style="padding:5px 5px 4px;max-width:215px;">
                  <div style="border-radius:6px;overflow:hidden;margin-bottom:4px;">
                    <div style="height:90px;position:relative;overflow:hidden;">
                      <svg width="215" height="90" viewBox="0 0 215 90" xmlns="http://www.w3.org/2000/svg"
                        style="display:block;">
                        <rect width="215" height="90" fill="#d4e8d0" />
                        <line x1="0" y1="45" x2="215" y2="45" stroke="#b8d4b4" stroke-width="7" />
                        <line x1="108" y1="0" x2="108" y2="90" stroke="#b8d4b4" stroke-width="7" />
                        <line x1="0" y1="22" x2="215" y2="22" stroke="#c5dcc2" stroke-width="2" opacity=".7" />
                        <line x1="0" y1="68" x2="215" y2="68" stroke="#c5dcc2" stroke-width="2" opacity=".7" />
                        <line x1="54" y1="0" x2="54" y2="90" stroke="#c5dcc2" stroke-width="2" opacity=".7" />
                        <line x1="162" y1="0" x2="162" y2="90" stroke="#c5dcc2" stroke-width="2" opacity=".7" />
                        <rect x="6" y="4" width="44" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="60" y="4" width="44" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="116" y="4" width="42" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="166" y="4" width="42" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="6" y="52" width="44" height="28" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="60" y="52" width="44" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="116" y="52" width="42" height="28" rx="2" fill="#bdd9b9" opacity=".8" />
                        <rect x="166" y="52" width="42" height="14" rx="2" fill="#bdd9b9" opacity=".8" />
                        <path d="M108 10c-6.6 0-12 5.4-12 12 0 9 12 22 12 22s12-13 12-22c0-6.6-5.4-12-12-12z"
                          fill="#10A7E1" />
                        <circle cx="108" cy="22" r="4.5" fill="#fff" />
                      </svg>
                    </div>
                    <div style="padding:6px 9px 3px;background:#DCF8C6;">
                      <div style="font-size:12.5px;font-weight:600;color:#111B21;">📍 {{brand.name}}, Manish Nagar
                      </div>
                      <div style="font-size:10.5px;color:#667781;margin-top:1px;">Manish Nagar, Nagpur · Live Location
                      </div>
                    </div>
                  </div>
                  <span class="mtime" style="padding-right:2px;">10:15 AM <span class="mtick">✓✓</span></span>
                </div>
              </div>
              <!-- Ravi replies with @zoai check-in -->
              <div class="mrw">
                <div class="you-lbl u-text-green">You (Ravi Singh)</div>
                <div class="ms">
                  <div class="rq" style="border-color:#2E7D32;">
                    <div class="rq-snd u-text-green">You (Ravi Singh)</div>
                    <div class="rq-txt">📍 {{brand.name}}, Manish Nagar</div>
                  </div>
                  <div class="mbody">@zoai check-in</div>
                  <span class="mtime">10:15 AM <span class="mtick">✓✓</span></span>
                </div>
              </div>
            </div>
            <div class="g-ibar">
              {{> icons/plus-circle color="#54656f"}}
              <div class="g-ifield">Type a message</div>
              {{> icons/microphone color="#54656f"}}
            </div>
          </div>
          <div class="screen-desc" style="background:#F4EEB4;">
            <strong>Check-In Command</strong>
            Ravi shares store location pin and replies @zoai check-in to log the store visit
          </div>
        </div>

        <!-- Screen 2: Check-in success -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 2 · Check-In Confirmed</div>
          <div class="group-phone">
            <div class="w-statusbar">
              <span class="w-stime">10:16</span>
              <div class="w-sicons">
                {{> icons/signal-bars color="#111"}}
                {{> icons/double-check color="#111"}}
                <div class="w-bat">73</div>
              </div>
            </div>
            <div class="g-topbar">
              <div class="g-back">
                {{> icons/back color="#007AFF"}}
              </div>
              <div class="g-ava u-avatar-circle-bg"><img
                  src="{{brandLogo}}"
                  class="u-avatar-circle"></div>
              <div class="g-info">
                <div class="g-name">{{brand.name}} x Manish Nagar</div>
                <div class="g-sub">Ravi Singh, Deepak Sharma, ZoAi</div>
              </div>
              <div class="g-acts">
                {{> icons/video color="#333"}}
                {{> icons/three-dots color="#333"}}
              </div>
            </div>
            <div class="g-chat">
              <div class="dpill">Today</div>
              <!-- Command echo -->
              <div class="mrw">
                <div class="you-lbl u-text-green">You (Ravi Singh)</div>
                <div class="ms">
                  <div class="rq" style="border-color:#2E7D32;">
                    <div class="rq-snd u-text-green">You (Ravi Singh)</div>
                    <div class="rq-txt">📍 {{brand.name}}, Manish Nagar</div>
                  </div>
                  <div class="mbody">@zoai check-in</div>
                  <span class="mtime">10:15 AM <span class="mtick">✓✓</span></span>
                </div>
              </div>
              <!-- ZoAi check-in success -->
              <div class="msw">
                <div class="mr">
                  <div class="sname u-text-teal">ZoAi 🤖</div>
                  <div class="mbody">Checked In ✅<br><br>📍 <strong>Store:</strong> {{brand.name}}, Manish Nagar<br>⏰
                    <strong>Time:</strong> 10:15 AM<br>📅 <strong>Date:</strong> 08 Apr 2026<br>👤 <strong>SE:</strong>
                    Ravi Singh
                  </div>
                  <span class="mtime">10:16 AM</span>
                </div>
              </div>
            </div>
            <div class="g-ibar">
              {{> icons/plus-circle color="#54656f"}}
              <div class="g-ifield">Type a message</div>
              {{> icons/microphone color="#54656f"}}
            </div>
          </div>
          <div class="screen-desc u-bg-purple">
            <strong>Check-In Confirmed</strong>
            ZoAi confirms store check-in with name, time and SE — visit logged, zero manual entry
          </div>
        </div>

      </div><!-- /step-5 -->