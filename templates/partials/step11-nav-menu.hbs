            <div class="pwa-content">
              <!-- App bar with logo as hamburger -->
              <div class="oh-header" style="display:flex;flex-direction:row;align-items:center;gap:10px;background:var(--brand);padding:10px 14px 10px;">
                <div class="tb-av" style="width:34px;height:34px;cursor:pointer;border:2px solid rgba(255,255,255,0.4);" title="Menu"><img src="{{brandLogo}}" alt="{{brand.name}}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"></div>
                <div style="flex:1;">
                  <div class="oh-title" style="font-size:13.5px;color:#fff;font-weight:700;line-height:1.2;">My Orders</div>
                  <div class="oh-sub" style="color:rgba(255,255,255,0.8);font-size:11px;">{{journey.dealer.name}}</div>
                </div>
              </div>
              <!-- Filter tabs -->
              <div class="filter-tabs">
                <button class="ft-pill active">All</button>
                <button class="ft-pill">Submitted</button>
                <button class="ft-pill">Approved</button>
                <button class="ft-pill">Billed</button>
                <button class="ft-pill">Dispatched</button>
              </div>
              <!-- Search bar -->
              <div class="search-bar-wrap">
                <div class="search-bar">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="7" stroke="#aaa" stroke-width="2"/><path d="M21 21l-3.8-3.8" stroke="#aaa" stroke-width="2" stroke-linecap="round"/></svg>
                  <input type="text" placeholder="Search by Order ID" readonly />
                </div>
              </div>
              <!-- Order cards -->
              <div class="order-cards">
                <!-- Card 1: Submitted — no download icon -->
                <div class="order-card">
                  <div class="oc-top">
                    <div><div class="oc-name">{{journey.dealer.name}}</div><div class="oc-id">Order {{journey.order.primaryOrderId}}</div></div>
                    <div class="oc-right">
                      <span class="status-badge badge-submitted">Submitted</span>
                      <svg class="oc-chev" width="7" height="12" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                  </div>
                  <div class="oc-details"><div class="oc-detail-item"><div class="oc-dval">{{formatCurrency journey.order.summary.orderValue}}</div><div class="oc-dlbl">Order Value</div></div><div class="oc-detail-item"><div class="oc-dval">Apr 22, 2026</div><div class="oc-dlbl">Order Date</div></div><div class="oc-detail-item"><div class="oc-dval">4 SKUs</div><div class="oc-dlbl">SKU Count</div></div></div>
                </div>
                <!-- Card 2: Approved — no download icon -->
                <div class="order-card">
                  <div class="oc-top">
                    <div><div class="oc-name">{{journey.dealer.name}}</div><div class="oc-id">Order {{journey.order.primaryOrderId}}</div></div>
                    <div class="oc-right">
                      <span class="status-badge badge-approved">Approved</span>
                      <svg class="oc-chev" width="7" height="12" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                  </div>
                  <div class="oc-details"><div class="oc-detail-item"><div class="oc-dval">{{formatCurrency journey.order.historyOrders.2.amount}}</div><div class="oc-dlbl">Order Value</div></div><div class="oc-detail-item"><div class="oc-dval">Apr 20, 2026</div><div class="oc-dlbl">Order Date</div></div><div class="oc-detail-item"><div class="oc-dval">3 SKUs</div><div class="oc-dlbl">SKU Count</div></div></div>
                </div>
                <!-- Card 3: Billed — with download icon -->
                <div class="order-card">
                  <div class="oc-top">
                    <div><div class="oc-name">{{journey.dealer.name}}</div><div class="oc-id">Order {{journey.order.primaryOrderId}}</div></div>
                    <div class="oc-right">
                      <div class="oc-dl-icon" title="Download Invoice">
                        <svg width="11" height="13" viewBox="0 0 14 16" fill="none"><path d="M7 1v9M4 7l3 4 3-4" stroke="#555" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 13h12" stroke="#555" stroke-width="1.6" stroke-linecap="round"/></svg>
                      </div>
                      <span class="status-badge badge-billed">Billed</span>
                      <svg class="oc-chev" width="7" height="12" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                  </div>
                  <div class="oc-details"><div class="oc-detail-item"><div class="oc-dval">{{formatCurrency journey.order.historyOrders.1.amount}}</div><div class="oc-dlbl">Order Value</div></div><div class="oc-detail-item"><div class="oc-dval">Apr 18, 2026</div><div class="oc-dlbl">Order Date</div></div><div class="oc-detail-item"><div class="oc-dval">6 SKUs</div><div class="oc-dlbl">SKU Count</div></div></div>
                </div>
                <!-- Card 4: Dispatched — with download icon -->
                <div class="order-card">
                  <div class="oc-top">
                    <div><div class="oc-name">{{journey.dealer.name}}</div><div class="oc-id">Order {{journey.order.primaryOrderId}}</div></div>
                    <div class="oc-right">
                      <div class="oc-dl-icon" title="Download Invoice">
                        <svg width="11" height="13" viewBox="0 0 14 16" fill="none"><path d="M7 1v9M4 7l3 4 3-4" stroke="#555" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M1 13h12" stroke="#555" stroke-width="1.6" stroke-linecap="round"/></svg>
                      </div>
                      <span class="status-badge badge-dispatched">Dispatched</span>
                      <svg class="oc-chev" width="7" height="12" viewBox="0 0 8 14" fill="none"><path d="M1 1l6 6-6 6" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </div>
                  </div>
                  <div class="oc-details"><div class="oc-detail-item"><div class="oc-dval">{{formatCurrency journey.order.historyOrders.0.amount}}</div><div class="oc-dlbl">Order Value</div></div><div class="oc-detail-item"><div class="oc-dval">Apr 15, 2026</div><div class="oc-dlbl">Order Date</div></div><div class="oc-detail-item"><div class="oc-dval">8 SKUs</div><div class="oc-dlbl">SKU Count</div></div></div>
                </div>
              </div><!-- /order-cards -->
            </div><!-- /pwa-content -->
            <!-- Browser nav -->
            <div class="browser-nav">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="18" cy="5" r="3" stroke="#555" stroke-width="1.8"/><circle cx="6" cy="12" r="3" stroke="#555" stroke-width="1.8"/><circle cx="18" cy="19" r="3" stroke="#555" stroke-width="1.8"/><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" stroke="#555" stroke-width="1.8"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><polyline points="23 4 23 10 17 10" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
          </div><!-- /phone-frame-web -->
          <div class="screen-desc" style="background:#FFF9C4;">
            <strong>{{journey.content.navOrderHistory}} — PWA</strong><br>
            Dealer sees their full order history with status filters. The {{brand.name}} logo in the header doubles as a hamburger menu — tapping it opens the navigation drawer to access other modules.
          </div>
        </div><!-- /phone-wrap Screen 1 -->

        <!-- Screen 2: PWA — Navigation Drawer open -->
   </div><!-- /phones-row -->
    
