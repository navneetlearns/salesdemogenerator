{{!-- Step 11: Self Service Navigation Menu — Embedded WhatsApp Web App (2 sub-screens)
--}}
<div id="step-11" class="step-section">
      <div class="step2-phones">

        <!-- Screen 1: Navigation Drawer -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 1 · Navigation Menu</div>
          <div class="screen-type-lbl">Embedded WhatsApp Web App — Self Service Side Drawer</div>
          <div class="phone-frame-web" style="position:relative;">
            <!-- Status bar -->
            {{> status-bar-web time="10:30" battery="84"}}
            <!-- Browser bar -->
            <div class="browser-bar">
              <span class="browser-done">Done</span>
              <div class="browser-url-wrap">
                <div class="browser-title">{{journey.content.navOrderHistory}}</div>
                <div class="browser-url">
                  <svg width="9" height="9" viewBox="0 0 12 12" fill="none"><circle cx="6" cy="6" r="5.5" stroke="#888" stroke-width="1"/><path d="M6 1v10M1 6h10" stroke="#888" stroke-width=".7"/><path d="M2 3.5Q6 2 10 3.5M2 8.5Q6 10 10 8.5" stroke="#888" stroke-width=".7" fill="none"/></svg>
                  mobile.zotok.ai
                </div>
              </div>
              <span class="browser-menu">···</span>
            </div>
            <!-- PWA content (blurred/dimmed behind drawer) -->
            <div class="pwa-content">
              <div class="oh-header" style="display:flex;flex-direction:row;align-items:center;gap:10px;background:var(--brand);padding:10px 14px 10px;">
                <div class="tb-av" style="width:34px;height:34px;cursor:pointer;border:2px solid rgba(255,255,255,0.4);"><img src="{{brandLogo}}" alt="{{brand.name}}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"></div>
                <div style="flex:1;"><div class="oh-title" style="font-size:13.5px;color:#fff;font-weight:700;line-height:1.2;">My Orders</div><div class="oh-sub" style="color:rgba(255,255,255,0.8);font-size:11px;">{{journey.dealer.name}}</div></div>
              </div>
              <div class="filter-tabs"><button class="ft-pill active">All</button><button class="ft-pill">Submitted</button><button class="ft-pill">Approved</button><button class="ft-pill">Billed</button></div>
              <div class="order-cards">
                <div class="order-card"><div class="oc-top"><div><div class="oc-name">{{journey.dealer.name}}</div><div class="oc-id">Order {{journey.order.primaryOrderId}}</div></div><span class="status-badge badge-submitted">Submitted</span></div></div>
                <div class="order-card"><div class="oc-top"><div><div class="oc-name">{{journey.dealer.name}}</div><div class="oc-id">Order {{journey.order.primaryOrderId}}</div></div><span class="status-badge badge-approved">Approved</span></div></div>
              </div>
            </div><!-- /pwa-content -->
            <!-- Browser nav -->
            <div class="browser-nav">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="#ccc" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="18" cy="5" r="3" stroke="#555" stroke-width="1.8"/><circle cx="6" cy="12" r="3" stroke="#555" stroke-width="1.8"/><circle cx="18" cy="19" r="3" stroke="#555" stroke-width="1.8"/><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" stroke="#555" stroke-width="1.8"/></svg>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><polyline points="23 4 23 10 17 10" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10" stroke="#555" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </div>
            <!-- ═══ SIDE DRAWER OVERLAY ═══ -->
            <div style="position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,0.45);z-index:20;">
              <!-- Drawer panel -->
              <div style="position:absolute;top:0;left:0;bottom:0;width:222px;background:#fff;box-shadow:4px 0 20px rgba(0,0,0,0.18);display:flex;flex-direction:column;">
                <!-- Drawer header: brand strip with logo + dealer info -->
                <div style="background:var(--brand);padding:18px 16px 14px;display:flex;align-items:center;gap:10px;flex-shrink:0;">
                  <div class="tb-av" style="width:42px;height:42px;border:2px solid rgba(255,255,255,0.4);flex-shrink:0;"><img src="{{brandLogo}}" alt="{{brand.name}}" style="width:100%;height:100%;object-fit:cover;border-radius:50%;"></div>
                  <div>
                    <div style="font-size:13px;font-weight:700;color:#fff;line-height:1.3;">{{brand.name}}</div>
                    <div style="font-size:11px;color:rgba(255,255,255,0.8);margin-top:2px;">{{journey.dealer.name}}</div>
                  </div>
                </div>
                <!-- Nav items -->
                <div style="flex:1;overflow-y:auto;">
                  <!-- Dashboard -->
                  <div class="pwa-nav-item">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="7" height="7" rx="1.5" fill="#888"/><rect x="14" y="3" width="7" height="7" rx="1.5" fill="#888"/><rect x="3" y="14" width="7" height="7" rx="1.5" fill="#888"/><rect x="14" y="14" width="7" height="7" rx="1.5" fill="#888"/></svg>
                    {{journey.content.navDashboard}}
                  </div>
                  <!-- Order History (active) -->
                  <div class="pwa-nav-item active">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="2"/><path d="M9 12h6M9 16h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    {{journey.content.navOrderHistory}}
                  </div>
                  <!-- Invoices -->
                  <div class="pwa-nav-item">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><polyline points="14 2 14 8 20 8" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><line x1="8" y1="13" x2="16" y2="13" stroke="#888" stroke-width="2" stroke-linecap="round"/><line x1="8" y1="17" x2="13" y2="17" stroke="#888" stroke-width="2" stroke-linecap="round"/></svg>
                    {{journey.content.navInvoices}}
                  </div>
                  <!-- Payments -->
                  <div class="pwa-nav-item">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><rect x="1" y="4" width="22" height="16" rx="2" stroke="#888" stroke-width="2"/><path d="M1 10h22" stroke="#888" stroke-width="2"/></svg>
                    {{journey.content.navPayments}}
                  </div>
                  <!-- Ledger -->
                  <div class="pwa-nav-item">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z" stroke="#888" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {{journey.content.navLedger}}
                  </div>
                </div>
                <!-- Drawer footer -->
                <div style="padding:12px 16px;border-top:1px solid #f0f0f0;font-size:11px;color:#aaa;text-align:center;">
                  Powered by ZoTok
                </div>
              </div><!-- /drawer panel -->
            </div><!-- /drawer overlay -->
          </div><!-- /phone-frame-web -->
          <div class="screen-desc" style="background:#E8EAF6;">
            <strong>Navigation Drawer</strong><br>
            Dealer taps the {{brand.name}} logo (hamburger) in the header — the side navigation drawer slides in, giving access to {{journey.content.navDashboard}}, {{journey.content.navOrderHistory}}, {{journey.content.navInvoices}}, {{journey.content.navPayments}}, and {{journey.content.navLedger}} from a single portal.
          </div>
        </div><!-- /phone-wrap Screen 2 -->

           <div class="screen-wrap">
          <div class="screen-lbl">Screen 2 · {{journey.content.navOrderHistory}}</div>
          <div class="screen-type-lbl">Embedded WhatsApp Web App — {{journey.content.orderDashboard}}</div>
          <div class="phone-frame-web">
            <!-- Status bar -->
            {{> status-bar-web time="10:30" battery="84"}}
            <!-- Browser bar -->
            <div class="browser-bar">
              <span class="browser-done">Done</span>
              <div class="browser-url-wrap">
                <div class="browser-title">{{journey.content.navOrderHistory}}</div>
