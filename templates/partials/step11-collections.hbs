            <div class="in-bar">
              <div class="in-plus">{{> icons/plus-circle color="#54656f"}}</div>
              <div class="in-field">Type a message</div>
              <div class="in-icons">
                {{> icons/camera color="#54656f"}}
                {{> icons/microphone color="#54656f"}}
              </div>
            </div>
          </div>
        </div>
        <div class="screen-desc" style="background:#fce4ec;"><strong>Alternate Path — Missed PTP</strong>Payment not
          received on committed date — ZoAi re-engages with a fresh date request or escalates to the field salesman.
        </div>
      </div>
    </div>
    </div>

    </div><!-- /step-11 -->
      { title: 'Step 1 — Automated Payment Reminder', desc: '<span class="u-text-base">ZoAi sends personalised outstanding reminders with dynamic UPI QR — zero salesman effort for routine collections</span><span class="tag tag-col">Collections</span><span class="tag tag-ai">AI Agents</span><span class="tag tag-pay">Payments</span>' },
      { title: 'Step 2 — Invoice Breakdown', desc: '<span class="u-text-base">Retailer queries pending bills — AI instantly shares invoice-wise breakdown within WhatsApp</span><span class="tag tag-col">Collections</span><span class="tag tag-ai">AI Agents</span>' },
      { title: 'Step 3 — AI Initiates PTP + Scheme Hook', desc: '<span class="u-text-base">ZoAi presents a time-sensitive scheme incentive to nudge the retailer towards committing a payment date</span><span class="tag tag-col">Collections</span><span class="tag tag-ai">AI Agents</span><span class="tag tag-sch">Scheme</span>' },
      { title: 'Step 4 — Retailer Declines Initial Date', desc: '<span class="u-text-base">Retailer says "not possible" — AI handles the decline gracefully and pivots to flexible negotiation</span><span class="tag tag-col">Collections</span><span class="tag tag-ai">AI Agents</span>' },
      { title: 'Step 5 — AI Offers Alternate Dates', desc: '<span class="u-text-base">ZoAi proposes multiple payment dates with scheme previews — retailer picks what suits their cashflow</span><span class="tag tag-col">Collections</span><span class="tag tag-ai">AI Agents</span><span class="tag tag-sch">Scheme</span>' },
      { title: 'Step 6 — Retailer Commits to Friday', desc: '<span class="u-text-base">Retailer selects a date — ZoAi captures the promise-to-pay and confirms the commitment</span><span class="tag tag-col">Collections</span>' },
      { title: 'Step 7 — Scheme Unlocked', desc: '<span class="u-text-base">ZoAi automatically unlocks the applicable scheme benefit tied to the committed PTP date</span><span class="tag tag-col">Collections</span><span class="tag tag-sch">Scheme</span>' },
      { title: 'Step 8 — PTP Confirmed', desc: '<span class="u-text-base">Promise-to-pay logged in ZoTok — distributor and sales team notified automatically</span><span class="tag tag-col">Collections</span>' },
      { title: 'Step 9 — Pre-Due Reminder', desc: '<span class="u-text-base">ZoAi sends a timely reminder a day before PTP date, reinforcing scheme incentive to maximise collection</span><span class="tag tag-col">Collections</span><span class="tag tag-ai">AI Agents</span>' },
      { title: 'Step 10 — Payment Received', desc: '<span class="u-text-base">Payment confirmed — scheme activated, collection cycle closed, retailer notified automatically</span><span class="tag tag-col">Collections</span><span class="tag tag-pay">Payments</span><span class="tag tag-sch">Scheme</span>' },
      { title: 'Step 11 — Missed PTP (Alternate Path)', desc: '<span class="u-text-base">Payment not received — ZoAi re-engages with a fresh date or escalates to field salesman for intervention</span><span class="tag tag-col">Collections</span><span class="tag tag-esc">Escalation</span>' },
    ];

    var descTimer = null;

    function goTo(n) {
      if (n < 1 || n > totalSteps) return;
      var prev = document.getElementById('step-' + currentStep);
      var prevSb = document.getElementById('sbstep-' + currentStep);
      if (prev) prev.classList.remove('active');
      if (prevSb) prevSb.classList.remove('active');
      currentStep = n;
      var next = document.getElementById('step-' + currentStep);
      var nextSb = document.getElementById('sbstep-' + currentStep);
      if (next) next.classList.add('active');
      if (nextSb) nextSb.classList.add('active');
      document.getElementById('counter-cur').textContent = currentStep;
      document.getElementById('prev-btn').disabled = (currentStep === 1);
      document.getElementById('next-btn').disabled = (currentStep === totalSteps);
      // Update step desc bar
      var sd = stepData[currentStep];
      if (sd) {
        var bar = document.getElementById('step-desc-bar');
        if (bar) bar.innerHTML = '<strong style="font-size:12.5px;color:#111;margin-right:6px;">' + sd.title + '</strong>' + sd.desc;
        var tbTitle = document.getElementById('tb-step-title');
        if (tbTitle) tbTitle.textContent = sd.title.replace('Step ' + currentStep + ' — ', '');
      }
      // Screen desc mobile
      clearTimeout(descTimer);
      document.querySelectorAll('.screen-desc').forEach(function (el) { el.classList.remove('desc-visible'); });
      var currentPanel = document.getElementById('step-' + currentStep);
      var currentDesc = currentPanel ? currentPanel.querySelector('.screen-desc') : null;
      if (currentDesc) { descTimer = setTimeout(function () { currentDesc.classList.add('desc-visible'); }, 1500); }
      setTimeout(function () {
        var chat = document.querySelector('#step-' + currentStep + ' .chat');
        if (chat) chat.scrollTop = chat.scrollHeight;
      }, 50);
    }

    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') goTo(currentStep + 1);
      if (e.key === 'ArrowLeft') goTo(currentStep - 1);
    });
    // Init desc bar
    (function () {
      var sd = stepData[1];
      if (sd) {
        var bar = document.getElementById('step-desc-bar');
        if (bar) bar.innerHTML = '<strong style="font-size:12.5px;color:#111;margin-right:6px;">' + sd.title + '</strong>' + sd.desc;
      }
      var currentDesc = document.querySelector('#step-1 .screen-desc');
      if (currentDesc) { descTimer = setTimeout(function () { currentDesc.classList.add('desc-visible'); }, 1500); }
    })();
  </script>
</body>

</html>