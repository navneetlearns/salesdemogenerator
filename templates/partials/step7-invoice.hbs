{{!-- Step 7: Invoice & Dispatch — Utility Template (2 sub-screens)
--}}
<div id="step-7" class="step-section">
      <div class="step2-phones">

        <!-- Screen 1: Invoice Notification -->
        <div class="screen-wrap">
          <div class="screen-lbl">Screen 1 · New Invoice</div>
          <div class="screen-type-lbl">Utility Template — Document Header + Quick Reply</div>
          <div class="phone-frame">
            {{> status-bar time="12:30 PM"}}
            {{> wa-topbar status="ZoTok Business" actions="call" compact=true avatarSrc=brandLogo}}
            <div class="chat-area">
              {{> date-pill text="Today"}}
              <div class="msg-receiver-wrap">
                <div class="wa-tmpl">
                  <div class="wa-hdr-doc">
                    <div class="doc-icon">{{> icons/document color="#54656f"}}</div>
                    <div class="doc-meta"><div class="doc-name">Invoice_{{journey.order.primaryOrderId}}.pdf</div><div class="doc-info">2 pages · 1.4 MB · pdf</div></div>
                    <div class="doc-dl">{{> icons/download color="#555"}}</div>
                  </div>
                  <div class="wa-tmpl-body">
                    <strong style="font-size:13px;display:block;margin-bottom:6px;">{{journey.content.newInvoiceRaised}}</strong>
                    Dear {{journey.dealer.name}}, your invoice for Order {{journey.order.primaryOrderId}} has been generated. Kindly review and make payment by the due date.<br><br>
                    🧾 Invoice No: <strong>JK-{{journey.invoice.id}}</strong><br>
                    📅 Invoice Date: <strong>{{journey.order.date}}</strong><br>
                    📦 Order Ref: <strong>{{journey.order.primaryOrderId}}</strong><br>
                    💰 Invoice Amount: <strong>{{formatCurrency journey.order.summary.orderValue}}</strong><br>
                    🏷 Cash Discount: <strong>2.5% ({{formatCurrency journey.invoice.discount}})</strong> if paid by <strong>{{journey.invoice.date}}</strong><br>
                    ⏰ Due Date: <strong>{{journey.invoice.dueDate}}</strong>
                  </div>
                  <div class="wa-tmpl-signoff">Team,<br>{{brand.name}}</div>
                  <div class="wa-tmpl-time">12:30 PM</div>
                                    <div class="wa-tmpl-btns">
                    <div class="wa-qr-btn">{{> icons/check-circle color="#00A884"}}{{journey.content.generatePaymentAdvice}}</div>
                    <div class="wa-qr-btn">{{> icons/check-circle color="#00A884"}}Raise an Issue</div>
                  </div>
                          </div>
              </div>
            </div>
            <div class="input-bar">{{> icons/plus-circle color="#54656f"}}<div class="input-field">Type a message</div>{{> icons/microphone color="#54656f"}}</div>
          </div>
          <div class="screen-desc" style="background:#FFF3CD;">
            <strong>New Invoice Notification</strong>
            When the order is billed in SAP, ZoTok instantly sends the invoice PDF to the dealer on WhatsApp. The message highlights the 2.5% cash discount window (7 days) and the full due date — prompting early payment.
          </div>
        </div><!-- /phone-wrap Screen 1 -->

        <!-- Screen 2: Cash Discount Reminder (1 day before discount expiry) -->
                <div class="screen-wrap">
          <div class="screen-lbl">Screen 2 · Dispatch Notification</div>
          <div class="screen-type-lbl">Utility Template — Document Header + CTA URL</div>
          <div class="phone-frame">
            {{> status-bar time="12:32 PM"}}
            {{> wa-topbar status="ZoTok Business" actions="call" compact=true avatarSrc=brandLogo}}
            <div class="chat-area">
              {{> date-pill text="Today"}}
              <div class="msg-receiver-wrap">
                <div class="wa-tmpl">
                  <div class="wa-hdr-doc">
                    <div class="doc-icon">{{> icons/document color="#54656f"}}</div>
                    <div class="doc-meta"><div class="doc-name">Dispatch.pdf</div><div class="doc-info">3 MB · PDF</div></div>
                    <div class="doc-dl">{{> icons/download color="#555"}}</div>
                  </div>
                  <div class="wa-tmpl-body">
                    <strong style="font-size:13px;display:block;margin-bottom:6px;">Dispatch Note</strong>
                    Please find the dispatch information below. If you have any questions, feel free to reach out to us.<br><br>
                    📅 Dispatch Date: <strong>{{journey.order.date}}</strong><br>
                    📄 Dispatch Document: <strong>{{journey.invoice.docId}}</strong><br>
                    🚚 Transporter: <strong>{{journey.order.transporter}}orts</strong><br>
                    🚗 Vehicle Number: <strong>TS01AK2025</strong><br>
                    📦 Delivery Terms: Ex-Works
                  </div>
                  <div class="wa-tmpl-signoff">Team,<br><strong>{{brand.name}}</strong></div>
                  <div class="wa-tmpl-time">12:32 PM</div>
                  <div class="wa-tmpl-btns">
                    <div class="wa-qr-btn">{{> icons/attach color="#00A884"}}View Dispatch</div>
                  </div>
                </div>
              </div>
            </div>
            <div class="input-bar">{{> icons/plus-circle color="#54656f"}}<div class="input-field">Type a message</div>{{> icons/microphone color="#54656f"}}</div>
          </div>
          <div class="screen-desc" style="background:#D1ECF1;">
            <strong>Dispatch Notification</strong>
            Once the order ships from the warehouse, ZoTok sends the dispatch note PDF with transporter and vehicle details so the dealer can track their delivery.
          </div>
        </div><!-- /phone-wrap Screen 2 -->

      </div><!-- /phones-row -->
    </div><!-- /step-7 -->
