{{!-- Step 1: Campaign & Promotions — 3 screens
  Screen 1 · Bulk Purchase Campaign (Marketing Template)
  Screen 2 · Product Category Selection (Interactive List)
  Screen 3 · Price List Response (Utility Template)
--}}
<div id="step-1" class="step-section active">

  <!-- Screen 1: Campaign -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Bulk Purchase Campaign</div>
    <div class="screen-type-lbl">Marketing Template — Image Header + Quick Reply</div>
    <div class="phone-frame">
      {{> status-bar time="10:15 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step1.campaign}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#FFF9C4;">
      <strong>Festive Campaign</strong>
      ZoTok pushes a targeted bulk purchase campaign to dealers, driving seasonal orders and awareness.
    </div>
  </div>

  <!-- Screen 2: Category Selection -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Product Category Selection</div>
    <div class="screen-type-lbl">Interactive List — Bottom Sheet Open</div>
    <div class="phone-frame">
      {{> status-bar time="10:17 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">Show me price list</div>
            <span class="msg-time">10:17 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        <div class="msg-receiver-wrap">
          <div class="wa-list-card">
            <div class="wa-list-body">{{journey.messages.step1.categoryQuestion}}</div>
            <div class="wa-list-time">10:17 AM</div>
            <div class="wa-list-btn-row">
              {{> icons/list-menu color="#00A884"}}
              <span class="wa-list-btn-label">Select a category</span>
            </div>
          </div>
        </div>
      </div>
      <div class="wa-bottom-sheet" style="background:#fff;border-top:1px solid #e0e0e0;padding:12px 16px;">
        <div style="font-size:14px;font-weight:600;color:#111;margin-bottom:8px;">Product Categories</div>
        <div class="menu-row" style="display:flex;gap:8px;flex-wrap:wrap;">
          {{#each journey.messages.step1.sections}}
            <div class="menu-chip u-chip">{{this.label}}</div>
          {{/each}}
        </div>
      </div>
    </div>
    <div class="screen-desc" style="background:#FFF9C4;">
      <strong>Product Query</strong>
      Dealer uses the interactive list to raise a query about a product category or pricing.
    </div>
  </div>

  <!-- Screen 3: Price List Response -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · Price List Response</div>
    <div class="screen-type-lbl">Utility Template — Document Header + CTA</div>
    <div class="phone-frame">
      {{> status-bar time="10:18 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step1.queryResponse}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#FFF9C4;">
      <strong>Instant Price List</strong>
      ZoAi instantly responds with the price list for the selected category, saving hours of back-and-forth.
    </div>
  </div>
</div>
