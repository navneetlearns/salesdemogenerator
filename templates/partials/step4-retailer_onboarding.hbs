{{!-- Step 4: Scheme & Product Queries — 3 screens
  Screen 1 · Scheme Notification (Marketing Template)
  Screen 2 · AI Typing Indicator (Session Message)
  Screen 3 · AI Explains Scheme (Session Message — Hinglish)
--}}
<div id="step-4" class="step-section">

  <!-- Screen 1: Scheme Notification -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Scheme Notification</div>
    <div class="screen-type-lbl">Marketing Template — Image Header + CTA Buttons</div>
    <div class="phone-frame">
      {{> status-bar time="10:30 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step4.scheme}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#E1BEE7;">
      <strong>Scheme Notification</strong>
      ZoTok pushes the latest scheme as a marketing message to retailers, driving awareness and incremental orders.
    </div>
  </div>

  <!-- Screen 2: AI Typing Indicator -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Retailer Asks — AI Typing</div>
    <div class="screen-type-lbl">Session Message — AI Typing Indicator</div>
    <div class="phone-frame">
      {{> status-bar time="10:31 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">Can you explain this scheme in Hindi?</div>
            <span class="msg-time">10:31 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        <div class="msg-receiver-wrap">
          <div class="wa-typing">
            <div class="wa-typing-dot"></div>
            <div class="wa-typing-dot"></div>
            <div class="wa-typing-dot"></div>
            <span style="font-size:11px;color:#888;margin-left:6px;">ZoAi is typing...</span>
          </div>
        </div>
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#E1BEE7;">
      <strong>Query to ZoAi</strong>
      Retailer sends a scheme-related question in natural language. ZoAi picks it up instantly and starts composing a response.
    </div>
  </div>

  <!-- Screen 3: AI Hinglish Response -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · AI Explains Scheme</div>
    <div class="screen-type-lbl">Session Message — AI Hinglish Response</div>
    <div class="phone-frame">
      {{> status-bar time="10:32 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step4.aiResponse}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#E1BEE7;">
      <strong>AI Response in Hinglish</strong>
      ZoAi explains the scheme in Hinglish, making it easy for the retailer to understand the offer and act on it immediately.
    </div>
  </div>
</div>
