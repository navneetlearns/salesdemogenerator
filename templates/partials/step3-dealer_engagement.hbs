{{!-- Step 3: Loyalty & Credit Queries — 3 screens
  Screen 1 · Dealer Loyalty Query (AI Chat — ZoAi Hinglish)
  Screen 2 · Dealer Credit Query (AI Chat — ZoAi Hinglish)
  Screen 3 · Dealer SE Escalation (AI Chat — ZoAi Hinglish)
--}}
<div id="step-3" class="step-section">

  <!-- Screen 1: Loyalty Query -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Dealer Loyalty Query</div>
    <div class="screen-type-lbl">AI Chat — ZoAi Hinglish Conversation</div>
    <div class="phone-frame">
      {{> status-bar time="10:45 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">How many loyalty points do I have?</div>
            <span class="msg-time">10:45 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        {{#with journey.messages.step3.loyaltyQuery}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#C8E6C9;">
      <strong>Points Wallet Inquiry</strong>
      Dealer asks ZoAi about their loyalty points balance. ZoAi responds with current points, tier status, and redemption options.
    </div>
  </div>

  <!-- Screen 2: Credit Query -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Dealer Credit Query</div>
    <div class="screen-type-lbl">AI Chat — ZoAi Hinglish Conversation</div>
    <div class="phone-frame">
      {{> status-bar time="10:47 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">What's my current credit limit?</div>
            <span class="msg-time">10:47 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        {{#with journey.messages.step3.creditQuery}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#C8E6C9;">
      <strong>Credit Note Alternative</strong>
      Dealer queries their credit balance. ZoAi shows usage &amp; available limit and offers to escalate credit limit increase requests.
    </div>
  </div>

  <!-- Screen 3: SE Escalation -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 3 · Dealer SE Escalation</div>
    <div class="screen-type-lbl">AI Chat — ZoAi Hinglish Conversation</div>
    <div class="phone-frame">
      {{> status-bar time="10:50 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">Yes, please escalate to my sales executive</div>
            <span class="msg-time">10:50 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        {{#with journey.messages.step3.escalation}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#C8E6C9;">
      <strong>Smart Escalation to Sales Executive</strong>
      When ZoAi cannot resolve the query directly, it seamlessly escalates to the dealer's dedicated Sales Executive with full context.
    </div>
  </div>
</div>
