{{!-- Step 2: Welcome & Self Service — 2 screens
  Screen 1 · Partner Approved (Session Interactive Message — Reply Button)
  Screen 2 · Self Service Menu (Interactive List — Bottom Sheet Open)
--}}
<div id="step-2" class="step-section">

  <!-- Screen 1: Partner Approved -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Registration Successful</div>
    <div class="screen-type-lbl">Session Interactive Message — Reply Button</div>
    <div class="phone-frame">
      {{> status-bar time="10:00 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step2.welcome}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        {{> icons/plus-circle color="#54656f"}}
        <div class="input-field">Type a message</div>
        {{> icons/microphone color="#54656f"}}
      </div>
    </div>
    <div class="screen-desc" style="background:#C8E6C9;">
      <strong>Partner Approved</strong>
      Once the application is reviewed and approved, the retailer automatically receives a welcome message on this channel.
    </div>
  </div>

  <!-- Screen 2: Self Service Menu -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Self Service Menu</div>
    <div class="screen-type-lbl">Interactive List — Bottom Sheet Open</div>
    <div class="phone-frame">
      {{> status-bar time="10:02 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">Open Menu</div>
            <span class="msg-time">10:02 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        <div class="msg-receiver-wrap">
          <div class="wa-list-card">
            <div class="wa-list-body">Namaste Ramesh! 🙏<br>How can I help you today?<br><br>👇 Select an option below</div>
            <div class="wa-list-time">10:02 AM</div>
            <div class="wa-list-btn-row">
              {{> icons/list-menu color="#00A884"}}
              <span class="wa-list-btn-label">What can I help with?</span>
            </div>
          </div>
        </div>
      </div>
      <div class="wa-bottom-sheet" style="background:#fff;border-top:1px solid #e0e0e0;padding:12px 16px;">
        <div style="font-size:14px;font-weight:600;color:#111;margin-bottom:8px;">Self Service Menu</div>
        <div class="menu-row" style="display:flex;gap:8px;flex-wrap:wrap;">
          <div class="menu-chip u-chip">🛒 Order Now</div>
          <div class="menu-chip u-chip">📋 Browse Products</div>
          <div class="menu-chip u-chip">💰 Current Schemes</div>
          <div class="menu-chip u-chip">📄 Price List</div>
          <div class="menu-chip u-chip">🧾 Invoices</div>
          <div class="menu-chip u-chip">💳 Payments</div>
          <div class="menu-chip u-chip">👤 My Account</div>
          <div class="menu-chip u-chip">🤖 AI Assistant</div>
        </div>
      </div>
    </div>
    <div class="screen-desc" style="background:#C8E6C9;">
      <strong>Self Service Menu</strong>
      Retailer is greeted with a multi-option interactive menu covering ordering, product queries, schemes, invoices, and dedicated support.
    </div>
  </div>
</div>
