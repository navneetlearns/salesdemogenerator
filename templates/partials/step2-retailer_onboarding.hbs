{{!-- Step 2: Welcome & Self Service — 2 screens
  Screen 1 · Partner Approved (Session Interactive Message — Reply Button)
  Screen 2 · Self Service Menu (Interactive List — Bottom Sheet Open)
--}}
<div id="step-2" class="step-section">

  <!-- Screen 1: Partner Approved -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 1 · Registration Successful</div>
    <div class="screen-type-lbl">Session Interactive Message — Reply Button</div>
    <div class="phone-frame">
      {{> status-bar time="10:00 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        {{#with journey.messages.step2.welcome}}
          {{> whatsapp-message}}
        {{/with}}
      </div>
      <div class="input-bar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="#54656f" stroke-width="1.8"/><path d="M12 8v8M8 12h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div class="input-field">Type a message</div>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 1a3 3 0 00-3 3v8a3 3 0 006 0V4a3 3 0 00-3-3z" stroke="#54656f" stroke-width="1.8"/><path d="M19 10v2a7 7 0 01-14 0v-2M12 19v4M8 23h8" stroke="#54656f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
    </div>
    <div class="screen-desc" style="background:#C8E6C9;">
      <strong>Partner Approved</strong>
      Once the application is reviewed and approved, the retailer automatically receives a welcome message on this channel.
    </div>
  </div>

  <!-- Screen 2: Self Service Menu -->
  <div class="screen-wrap">
    <div class="screen-lbl">Screen 2 · Self Service Menu</div>
    <div class="screen-type-lbl">Interactive List — Bottom Sheet Open</div>
    <div class="phone-frame">
      {{> status-bar time="10:02 AM"}}
      {{> wa-topbar status="Business Account" actions="video+more" avatarSrc=brandLogo}}
      <div class="chat-area">
        {{> date-pill text="Today"}}
        <div class="msg-sender-wrap">
          <div class="msg-sender">
            <div class="msg-body">Open Menu</div>
            <span class="msg-time">10:02 AM <span class="msg-tick">✓✓</span></span>
          </div>
        </div>
        <div class="msg-receiver-wrap">
          <div class="wa-list-card">
            <div class="wa-list-body">Namaste Ramesh! 🙏<br>How can I help you today?<br><br>👇 Select an option below</div>
            <div class="wa-list-time">10:02 AM</div>
            <div class="wa-list-btn-row">
              <svg width="15" height="13" viewBox="0 0 24 20" fill="none"><line x1="0" y1="2" x2="24" y2="2" stroke="#00A884" stroke-width="2.5"/><line x1="0" y1="10" x2="24" y2="10" stroke="#00A884" stroke-width="2.5"/><line x1="0" y1="18" x2="24" y2="18" stroke="#00A884" stroke-width="2.5"/></svg>
              <span class="wa-list-btn-label">What can I help with?</span>
            </div>
          </div>
        </div>
      </div>
      <div class="wa-bottom-sheet" style="background:#fff;border-top:1px solid #e0e0e0;padding:12px 16px;">
        <div style="font-size:14px;font-weight:600;color:#111;margin-bottom:8px;">Self Service Menu</div>
        <div class="menu-row" style="display:flex;gap:8px;flex-wrap:wrap;">
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">🛒 Order Now</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">📋 Browse Products</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">💰 Current Schemes</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">📄 Price List</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">🧾 Invoices</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">💳 Payments</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">👤 My Account</div>
          <div class="menu-chip" style="padding:6px 12px;background:#f0f0f0;border-radius:16px;font-size:12px;color:#333;">🤖 AI Assistant</div>
        </div>
      </div>
    </div>
    <div class="screen-desc" style="background:#C8E6C9;">
      <strong>Self Service Menu</strong>
      Retailer is greeted with a multi-option interactive menu covering ordering, product queries, schemes, invoices, and dedicated support.
    </div>
  </div>
</div>
