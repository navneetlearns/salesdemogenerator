{
  "name": "@zotok/demo-generator",
  "version": "1.0.0",
  "description": "ZoTok WhatsApp Commerce Journey Demo Generator - CLI tool to generate interactive brand demo HTML pages",
  "bin": {
    "demo-generator": "./bin/demo-generator"
  },
  "private": false,
  "scripts": {
    "build": "node build.js",
    "build:dist": "node build.js --dist",
    "build:brand": "node bin/demo-generator build --brand",
    "init": "node bin/demo-generator init",
    "build:all": "node bin/demo-generator build-all --dist",
    "test": "node --test test/*.test.js",
    "validate": "node scripts/validate.js",
    "visual:baseline": "node scripts/visual-baseline.js",
    "visual:test": "node scripts/visual-test.js",
    "visual:haldirams-source": "node scripts/visual-compare-haldirams-source.js",
    "visual:report": "node build/visual-regression.js",
    "fingerprint": "node build/layout-fingerprint.js",
    "runtime": "node runtime/index.js",
    "runtime:server": "node runtime/preview-server.js",
    "validate:runtime": "node runtime/validate-runtime.js",
    "cleanup": "node -e \"require('./runtime/cleanup').cleanup().then(()=>process.exit(0))\""
  },
  "dependencies": {
    "@vercel/blob": "^2.4.0",
    "ajv": "^8.20.0",
    "busboy": "^1.6.0",
    "cheerio": "^1.2.0",
    "chokidar": "^4.0.3",
    "express": "^5.2.1",
    "file-type": "^18.0.0",
    "fs-extra": "^11.1.1",
    "got": "^15.0.5",
    "handlebars": "^4.7.9",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "node-vibrant": "^3.1.6",
    "sharp": "^0.33.5",
    "uuid": "^14.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/navneetlearns/salesdemogenerator.git"
  },
  "keywords": [
    "zotok",
    "whatsapp",
    "commerce",
    "demo",
    "generator"
  ],
  "license": "MIT",
  "vercel": {
    "buildCommand": "npm install",
    "outputDirectory": "runtime/frontend/public",
    "functions": {
      "api/*.js": {
        "maxDuration": 60
      }
    }
  }
}
