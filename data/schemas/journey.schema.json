{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "brandId": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "num": { "type": "number" },
          "displayNum": { "type": ["number", "string"] },
          "title": { "type": "string" },
          "meta": { "type": "string" },
          "navTitle": { "type": "string" },
          "navDesc": { "type": "string" }
        },
        "required": ["title"]
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "partial": { "type": "string" }
        }
      }
    },
    "cart": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "qty": { "type": "number" },
              "tag": { "type": "string" }
            },
            "required": ["productId"]
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "totalItems": { "type": ["number", "string"] },
            "totalQuantity": { "type": "string" },
            "orderValue": { "type": "string" }
          }
        }
      }
    },
    "messages": { "type": "object" }
  },
  "required": ["id", "title"]
}
