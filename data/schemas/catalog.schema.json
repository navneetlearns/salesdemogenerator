{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": { "type": "string" },
      "sku": { "type": "string" },
      "name": { "type": "string" },
      "category": { "type": "string" },
      "price": { "type": "number" },
      "unit": { "type": "string" },
      "image": { "type": "string" },
      "tags": { "type": "array", "items": { "type": "string" } },
      "meta": { "type": "object" },
      "qty": { "type": "number" },
      "tag": { "type": "string" }
    },
    "required": ["id", "name", "price", "image"]
  }
}
