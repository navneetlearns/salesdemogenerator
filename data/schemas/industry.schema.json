  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "label": { "type": "string" },
    "partnerLabel": { "type": "string" },
    "unit": { "type": "string" },
    "unitPlural": { "type": "string" },
    "currency": { "type": "string" },
    "currencySymbol": { "type": "string" },
    "categoryTabs": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["id", "label"]
}
