{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "shortName": { "type": "string" },
    "industry": { "type": "string" },
    "logo": { "type": "string" },
    "colors": {
      "type": "object",
      "properties": {
        "brand": { "type": "string" },
        "brandDark": { "type": "string" },
        "accent": { "type": "string" }
      },
      "required": ["brand", "brandDark", "accent"]
    },
    "assets": {
      "type": "object",
      "properties": {
        "logo": { "type": "string" },
        "logoDark": { "type": "string" },
        "favicon": { "type": "string" },
        "heroBanner": { "type": "string" }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "colors": { "type": "object" },
        "fonts": { "type": "object" },
        "radius": { "type": "object" },
        "spacing": { "type": "object" },
        "shadows": { "type": "object" }
      }
    },
    "font": { "type": "string" },
    "fonts": { "type": "array", "items": { "type": "string" } },
    "replacements": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  },
  "required": ["name", "colors"]
}
