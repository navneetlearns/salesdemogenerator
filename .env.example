# Required
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Required — server-side admin operations
SUPABASE_SECRET_KEY=sb_secret_...

# Cloudflare deployment
# Create a token at https://dash.cloudflare.com/profile/api-tokens
# Permission: Cloudflare Pages -> Edit
# CRITICAL: Do NOT add IP address restrictions — without them it works from
# any location (WSL, GitHub Actions, CI/CD, coworking space, roaming laptop).
# With IP restrictions you'll need to update the whitelist every time your IP changes.
CLOUDFLARE_API_TOKEN=cfat_...
CLOUDFLARE_ACCOUNT_ID=your_account_id
